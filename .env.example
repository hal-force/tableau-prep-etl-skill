# Copy to .env (gitignored) and fill in your values, or export in your shell.

# LLM gateway (OpenAI-compatible /chat/completions endpoint)
LLM_GATEWAY_URL=https://your-gateway/chat/completions
LLM_GATEWAY_KEY=
LLM_GATEWAY_MODEL=claude-sonnet-4-6
# LLM_GATEWAY_VERIFY_SSL=true   # set false only for a dev gateway with a self-signed cert

# Corpus + outputs (default: per-run runtime/<run_id>/{inputs,outputs}/)
CORPUS_DIR=
OUTPUTS_DIR=

# Tableau Prep CLI binary
TABLEAU_PREP_CLI=/Applications/Tableau Prep Builder (Apple silicon) 2026.1.app/Contents/scripts/tableau-prep-cli

# v2 (server publishing) — leave empty in v1
TABLEAU_SERVER_URL=
TABLEAU_SERVER_PAT_NAME=
TABLEAU_SERVER_PAT_SECRET=
TABLEAU_SERVER_SITE=
TABLEAU_SERVER_PROJECT=

# Optional: username/password for local prep-cli runs of flows with
# internal_published_ds sources (prep-cli v2026.1 rejects PATs).
# TABLEAU_SERVER_USERNAME=
# TABLEAU_SERVER_PASSWORD=

# Optional skill knobs (sensible defaults if unset)
# TPE_HOST_APPROVAL=interactive          # interactive | auto-trust-known | deny-unknown | trust-all
# TABLEAU_PREP_ETL_CONFIG_DIR=            # default: ~/.tableau-prep-etl
# MAX_REFINEMENT_ITERATIONS=3
# REFINEMENT_THRESHOLD=0.85
