# Copy to .env (gitignored) and fill in your values, or export in your shell.

# LLM gateway (OpenAI-compatible /chat/completions endpoint)
LLM_GATEWAY_URL=https://your-gateway/chat/completions
LLM_GATEWAY_KEY=
LLM_GATEWAY_MODEL=claude-sonnet-4-6

# Corpus + outputs (default: per-run runtime/<run_id>/{inputs,outputs}/)
CORPUS_DIR=
OUTPUTS_DIR=

# Tableau Prep CLI binary
TABLEAU_PREP_CLI=/Applications/Tableau Prep Builder (Apple silicon) 2026.1.app/Contents/scripts/tableau-prep-cli

# v2 (server publishing) — leave empty in v1
TABLEAU_SERVER_URL=
TABLEAU_SERVER_PAT_NAME=
TABLEAU_SERVER_PAT_SECRET=
TABLEAU_SERVER_SITE=
TABLEAU_SERVER_PROJECT=
