def _band(score, mass_violence_close_recent):
    if mass_violence_close_recent or score >= 500:
        return "CRITICAL"
    if score >= 150:
        return "HIGH"
    if score >= 30:
        return "ELEVATED"
    if score >= 1:
        return "GUARDED"
    return "LOW"


def summarize(df):
    """Per-post weighted aggregation. Input is the event-level dataframe
    from embassy_threat_join. Output is one row per post in the
    roster — including posts with zero events in the window."""
    cols_out = _added_cols()

    posts = pd.DataFrame(_EMBASSY_ROSTER)
    base = posts[["post_name", "post_country", "post_classification",
                  "post_lat", "post_lon"]].copy()

    if df is None or len(df) == 0 or "post_name" not in (df.columns if df is not None else []):
        # No events at all - emit roster with all-LOW band.
        base["events_in_window"]      = 0
        base["max_severity_score"]    = 0
        base["mass_violence_count"]   = 0
        base["assault_count"]         = 0
        base["fight_count"]           = 0
        base["threaten_count"]        = 0
        base["protest_count"]         = 0
        base["coerce_count"]          = 0
        base["weighted_threat_score"] = 0.0
        base["risk_band"]             = "LOW"
        base["top_event_type"]        = ""
        base["last_event_date"]       = ""
        return base[cols_out]

    df = df.copy()
    # Recency-decay weight: events within last `WINDOW_DAYS`. Linear
    # decay 1.0 (today) -> 0.0 (window edge); events older than the
    # window get weight 0 and don't contribute.
    df["event_dt"] = pd.to_datetime(df["event_date"], errors="coerce", utc=True)
    now = pd.Timestamp(datetime.now(timezone.utc))
    df["days_old"] = (now - df["event_dt"]).dt.total_seconds() / 86400.0
    df["recency_weight"] = (1.0 - (df["days_old"] / float(WINDOW_DAYS))).clip(lower=0.0, upper=1.0)
    in_window = df[df["recency_weight"] > 0].copy()
    in_window["weighted"] = in_window["composite_score"] * in_window["recency_weight"]

    # CRITICAL escalator: any mass-violence (root 20) within 30mi and 72h.
    in_window["_critical_flag"] = (
        (in_window["event_root_code"].astype(str) == "20")
        & (pd.to_numeric(in_window["distance_miles"], errors="coerce") < 30)
        & (in_window["days_old"] < 3)
    )

    # Group by post.
    grp = in_window.groupby("post_name")
    agg = grp.agg(
        events_in_window=("event_id", "count"),
        max_severity_score=("severity_score", "max"),
        weighted_threat_score=("weighted", "sum"),
        last_event_date=("event_date", "max"),
        critical_flag=("_critical_flag", "any"),
    ).reset_index()

    # Per-class counts (CAMEO root code -> column).
    counts = (
        in_window.groupby(["post_name", "event_root_code"])
        .size().unstack(fill_value=0).reset_index()
    )
    for code, col in [("13", "threaten_count"), ("14", "protest_count"),
                       ("17", "coerce_count"), ("18", "assault_count"),
                       ("19", "fight_count"), ("20", "mass_violence_count")]:
        if code not in counts.columns:
            counts[code] = 0
        counts.rename(columns={code: col}, inplace=True)
    keep = ["post_name", "threaten_count", "protest_count", "coerce_count",
            "assault_count", "fight_count", "mass_violence_count"]
    counts = counts[[c for c in keep if c in counts.columns]]

    # Top event type per post (highest-severity, then most recent).
    top = (in_window.sort_values(["severity_score", "event_dt"], ascending=[False, False])
                    .drop_duplicates("post_name")[["post_name", "event_root_name"]]
                    .rename(columns={"event_root_name": "top_event_type"}))

    # Merge everything onto the full roster (left join: posts with no
    # events still appear).
    out = base.merge(agg, on="post_name", how="left") \
              .merge(counts, on="post_name", how="left") \
              .merge(top, on="post_name", how="left")

    # Fill defaults for posts with no events in window.
    int_cols = ["events_in_window", "max_severity_score",
                "threaten_count", "protest_count", "coerce_count",
                "assault_count", "fight_count", "mass_violence_count"]
    for c in int_cols:
        if c not in out.columns:
            out[c] = 0
        out[c] = pd.to_numeric(out[c], errors="coerce").fillna(0).astype(int)
    out["weighted_threat_score"] = pd.to_numeric(
        out.get("weighted_threat_score", 0), errors="coerce").fillna(0.0).round(2)
    out["last_event_date"] = out.get("last_event_date", "").fillna("").astype(str)
    out["top_event_type"]  = out.get("top_event_type", "").fillna("").astype(str)
    out["critical_flag"]   = out.get("critical_flag", False).fillna(False).astype(bool)

    out["risk_band"] = [
        _band(s, c) for s, c in zip(out["weighted_threat_score"], out["critical_flag"])
    ]

    return out[cols_out]


def _added_cols():
    return [
        "post_name", "post_country", "post_classification",
        "post_lat", "post_lon",
        "events_in_window", "max_severity_score",
        "mass_violence_count", "assault_count", "fight_count",
        "threaten_count", "protest_count", "coerce_count",
        "weighted_threat_score", "risk_band", "top_event_type",
        "last_event_date",
    ]


