"""
Tableau Prep Script: spatial join of GDELT events to US diplomatic posts.

Generated by tableau-prep-etl skill from
templates/embassy_threat_join.py.j2.

Consumes a single dataframe (one row per GDELT event for the latest
feed window) and emits one row per (US post, event) within the
configured haversine radius for events whose CAMEO root code is in the
threat-class set and whose date falls within the configured lookback
window.

Why this lives in TabPy: Tableau Prep does not have a native
great-circle distance calculation or a spatial join. Tableau Desktop
has MAKEPOINT/DISTANCE, but those are unavailable in Prep flows.
A pandas haversine over the embassy roster (a few dozen posts) against
the GDELT events (~hundreds of thousands of rows worst-case) is fast
and runs in TabPy in under a second.

Per-row outputs added (event-level, one per post-event pair within range):
  post_name             curated roster name
  post_country          ISO 2-letter country code of the post
  post_classification   Embassy | Consulate | Mission
  post_lat, post_lon    roster coordinates
  distance_miles        haversine miles between post and event
  severity_score        0-4 derived from CAMEO root (mass-violence=4)
  proximity_score       0-3 derived from distance_miles
  recency_score         0-3 derived from days since event
  us_actor_flag         1 if Actor1/Actor2 CountryCode == 'USA' else 0
  composite_score       severity*2 + proximity + recency + us_actor_flag
  event_root_name       human-readable CAMEO root label

Roster scope: a vetted demo set of ~50 US diplomatic posts derived
from the public State.gov listing - capital embassies + named major
consulates with elevated security profile. For production deployment
the customer would substitute their own authoritative roster (a CSV
or an internal published DS); the script's contract is just
{post_name, post_country, post_classification, lat, lon}.
"""
from datetime import datetime, timedelta, timezone
from math import asin, cos, radians, sin, sqrt

import pandas as pd


RADIUS_MILES   = {{ radius_miles }}
LOOKBACK_DAYS  = {{ lookback_days }}
CAMEO_ROOTS    = {{ cameo_root_codes | pyrepr }}

LAT_COL              = "{{ lat_col }}"
LON_COL              = "{{ lon_col }}"
DATE_COL             = "{{ date_col }}"
EVENT_ROOT_COL       = "{{ event_root_col }}"
EVENT_CODE_COL       = "{{ event_code_col }}"
GOLDSTEIN_COL        = "{{ goldstein_col }}"
ACTOR1_COUNTRY_COL   = "{{ actor1_country_col }}"
ACTOR2_COUNTRY_COL   = "{{ actor2_country_col }}"
ACTOR1_NAME_COL      = "{{ actor1_name_col }}"
ACTOR2_NAME_COL      = "{{ actor2_name_col }}"
ACTION_GEO_FULL_COL  = "{{ action_geo_full_col }}"
NUM_MENTIONS_COL     = "{{ num_mentions_col }}"
SOURCE_URL_COL       = "{{ source_url_col }}"

INPUT_SCHEMA: dict = {{ input_schema | pyrepr if input_schema is defined else '{}' }}


# CAMEO root code -> (severity_score, human label).
# Severity scale: 0=cooperative, 1=verbal disagreement, 2=demand/protest,
# 3=physical conflict, 4=mass violence. We only score threat classes
# (>= 13); anything below filters out at the root-code gate.
_CAMEO_SEVERITY = {
    "13": (2, "Threaten"),
    "14": (1, "Protest"),
    "17": (2, "Coerce"),
    "18": (3, "Assault"),
    "19": (3, "Fight"),
    "20": (4, "Mass violence"),
}


# Threat-class CAMEO EventCode -> human label. GDELT 1.0 ships only the
# event taxonomy code, not a narrative description, so the dashboard's
# best "free-text" surface is a composed sentence using these labels +
# the as-reported actor names + the geocoded place. Covers the leaf
# codes under threat roots 13/14/17/18/19/20; falls back to the root
# label for any codes not in this table.
_CAMEO_EVENT_LABEL = {
    "130": "threatened",
    "131": "threatened with non-force",
    "132": "threatened with administrative sanctions",
    "133": "threatened to halt negotiations",
    "134": "threatened to halt mediation",
