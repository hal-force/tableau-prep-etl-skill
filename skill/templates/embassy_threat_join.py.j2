    "140": "engaged in political dissent against",
    "141": "demonstrated against",
    "1411": "demonstrated for policy change against",
    "1412": "demonstrated for leadership change against",
    "1413": "demonstrated for rights against",
    "1414": "demonstrated for regime change against",
    "142": "conducted a hunger strike against",
    "143": "conducted a strike or boycott against",
    "144": "obstructed passage or blocked",
    "145": "protested violently against",
    "170": "coerced",
    "171": "seized or damaged property of",
    "172": "imposed administrative sanctions on",
    "173": "arrested or detained",
    "174": "expelled or deported",
    "175": "took hostage of",
    "176": "imposed restrictions on",
    "180": "used unconventional violence against",
    "181": "abducted or hijacked",
    "182": "physically assaulted",
    "1821": "sexually assaulted",
    "1822": "tortured",
    "1823": "killed by physical assault",
    "183": "conducted a suicide, car, or other non-military bombing against",
    "1831": "carried out a suicide bombing against",
    "1832": "carried out a car bombing against",
    "1833": "carried out a roadside bombing against",
    "184": "used as human shield",
    "185": "attempted to assassinate",
    "186": "assassinated",
    "190": "fought with",
    "191": "imposed blockade or restricted movement of",
    "192": "occupied territory of",
    "193": "fought with small-arms or light weapons against",
    "194": "fought with artillery and tanks against",
    "195": "employed aerial weapons against",
    "196": "violated a ceasefire with",
    "200": "engaged in mass-violence against",
    "201": "engaged in mass-expulsion of",
    "202": "engaged in mass-killing of",
    "203": "engaged in ethnic cleansing of",
}


def _event_label(event_code: str, root_code: str, root_label: str) -> str:
    """Pick the most-specific human verb available for the EventCode."""
    code = (event_code or "").strip()
    if code in _CAMEO_EVENT_LABEL:
        return _CAMEO_EVENT_LABEL[code]
    # Try the 3-digit base if a 4-digit leaf wasn't in the table.
    if len(code) >= 3 and code[:3] in _CAMEO_EVENT_LABEL:
        return _CAMEO_EVENT_LABEL[code[:3]]
    return root_label.lower() + "ed" if root_label else "engaged with"


def _compose_summary(actor1: str, actor2: str, verb: str, place: str, date_str: str) -> str:
    """Compose a one-sentence narrative from the available coded fields.

    Falls back gracefully when actor names are missing (GDELT often
    reports a verb against an unspecified counter-party).
    """
    a1 = (actor1 or "").strip().title() or "Unknown actor"
    a2 = (actor2 or "").strip().title()
    where = (place or "").strip()
    if a2:
        sentence = f"{a1} {verb} {a2}"
    else:
        sentence = f"{a1} {verb}"
    if where:
        sentence += f" in {where}"
    if date_str:
        sentence += f" on {date_str}"
    return sentence + "."


