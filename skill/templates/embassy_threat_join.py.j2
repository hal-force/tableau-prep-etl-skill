def _haversine_miles(lat1, lon1, lat2, lon2) -> float:
    """Great-circle distance in statute miles."""
    R_MI = 3958.7613
    lat1r, lat2r = radians(lat1), radians(lat2)
    dlat = lat2r - lat1r
    dlon = radians(lon2 - lon1)
    a = sin(dlat / 2) ** 2 + cos(lat1r) * cos(lat2r) * sin(dlon / 2) ** 2
    return 2 * R_MI * asin(sqrt(min(1.0, a)))


def _parse_gdelt_date(v) -> pd.Timestamp:
    """GDELT 1.0 SQLDATE is YYYYMMDD as int or string."""
    if v is None or pd.isna(v):
        return pd.NaT
    s = str(v).strip().split(".")[0]
    if len(s) != 8 or not s.isdigit():
        return pd.NaT
    try:
        return pd.Timestamp(year=int(s[:4]), month=int(s[4:6]), day=int(s[6:8]), tz="UTC")
    except (ValueError, TypeError):
        return pd.NaT


def _proximity_score(miles: float) -> int:
    if miles < 5:    return 3
    if miles < 15:   return 2
    if miles < 30:   return 1
    return 0


def _recency_score(days_old: float) -> int:
    if pd.isna(days_old) or days_old < 0:
        return 0
    if days_old < 1:    return 3
    if days_old < 3:    return 2
    if days_old < 7:    return 1
    return 0


def join_threats(df):
    """Spatial-join GDELT events to the embassy roster + score each pair."""
    cols_out = _added_cols()
    if df is None or len(df) == 0:
        return pd.DataFrame(columns=cols_out)

    df = df.copy()
    if EVENT_ROOT_COL not in df.columns:
        return pd.DataFrame(columns=cols_out)
    df[EVENT_ROOT_COL] = df[EVENT_ROOT_COL].astype(str).str.strip().str.zfill(2)
    df = df[df[EVENT_ROOT_COL].isin(CAMEO_ROOTS)]
    if len(df) == 0:
        return pd.DataFrame(columns=cols_out)

    if LAT_COL not in df.columns or LON_COL not in df.columns:
        return pd.DataFrame(columns=cols_out)
    df[LAT_COL] = pd.to_numeric(df[LAT_COL], errors="coerce")
    df[LON_COL] = pd.to_numeric(df[LON_COL], errors="coerce")
    df = df[df[LAT_COL].notna() & df[LON_COL].notna()]

    if DATE_COL in df.columns:
        df["_event_dt"] = df[DATE_COL].apply(_parse_gdelt_date)
        cutoff = pd.Timestamp(datetime.now(timezone.utc)) - timedelta(days=LOOKBACK_DAYS)
        df = df[df["_event_dt"].notna() & (df["_event_dt"] >= cutoff)]
    else:
        df["_event_dt"] = pd.NaT

    if len(df) == 0:
        return pd.DataFrame(columns=cols_out)

    now = pd.Timestamp(datetime.now(timezone.utc))

    posts = pd.DataFrame(_EMBASSY_ROSTER)

    rows = []
    for _, ev in df.iterrows():
        ev_lat = float(ev[LAT_COL])
        ev_lon = float(ev[LON_COL])
        for _, post in posts.iterrows():
            d = _haversine_miles(post["post_lat"], post["post_lon"], ev_lat, ev_lon)
            if d > RADIUS_MILES:
                continue
            sev_score, sev_label = _CAMEO_SEVERITY.get(ev[EVENT_ROOT_COL], (0, "Other"))
            prox = _proximity_score(d)
            ev_dt = ev.get("_event_dt")
            days_old = (now - ev_dt).total_seconds() / 86400.0 if ev_dt is not None and not pd.isna(ev_dt) else float("nan")
            recency = _recency_score(days_old)
            a1c = str(ev.get(ACTOR1_COUNTRY_COL) or "").strip().upper()
            a2c = str(ev.get(ACTOR2_COUNTRY_COL) or "").strip().upper()
            us_actor = 1 if a1c == "USA" or a2c == "USA" else 0
            composite = sev_score * 2 + prox + recency + us_actor

            actor1_name = str(ev.get(ACTOR1_NAME_COL) or "").strip()
            actor2_name = str(ev.get(ACTOR2_NAME_COL) or "").strip()
            place_full  = str(ev.get(ACTION_GEO_FULL_COL) or "").strip()
            event_code  = str(ev.get(EVENT_CODE_COL) or "").strip()
            event_full_name = _event_label(event_code, ev[EVENT_ROOT_COL], sev_label)
            event_date_str = ev_dt.strftime("%Y-%m-%d") if ev_dt is not None and not pd.isna(ev_dt) else ""
            event_summary = _compose_summary(actor1_name, actor2_name, event_full_name, place_full, event_date_str)

            rows.append({
                "post_name":           post["post_name"],
                "post_country":        post["post_country"],
                "post_classification": post["post_classification"],
                "post_lat":            float(post["post_lat"]),
                "post_lon":            float(post["post_lon"]),
                "event_id":            str(ev.get("GLOBALEVENTID") or ""),
                "event_date":          event_date_str,
                "event_root_code":     ev[EVENT_ROOT_COL],
                "event_root_name":     sev_label,
                "event_code":          event_code,
                "event_full_name":     event_full_name,
                "event_lat":           ev_lat,
                "event_lon":           ev_lon,
                "distance_miles":      round(d, 2),
                "severity_score":      int(sev_score),
                "proximity_score":     int(prox),
                "recency_score":       int(recency),
                "us_actor_flag":       int(us_actor),
                "composite_score":     int(composite),
                "goldstein_scale":     float(pd.to_numeric(ev.get(GOLDSTEIN_COL), errors="coerce") or 0.0),
                "num_mentions":        int(pd.to_numeric(ev.get(NUM_MENTIONS_COL), errors="coerce") or 0),
                "source_url":          str(ev.get(SOURCE_URL_COL) or ""),
                "actor1_country":      a1c,
                "actor2_country":      a2c,
                "actor1_name":         actor1_name,
                "actor2_name":         actor2_name,
                "action_geo_fullname": place_full,
                "event_summary":       event_summary,
            })

    if not rows:
        return pd.DataFrame(columns=cols_out)
    out = pd.DataFrame(rows, columns=cols_out)
    return out


def _added_cols():
    return [
        "post_name", "post_country", "post_classification",
        "post_lat", "post_lon",
        "event_id", "event_date", "event_root_code", "event_root_name",
        "event_code", "event_full_name",
        "event_lat", "event_lon",
        "distance_miles",
        "severity_score", "proximity_score", "recency_score",
        "us_actor_flag", "composite_score",
        "goldstein_scale", "num_mentions", "source_url",
        "actor1_country", "actor2_country",
        "actor1_name", "actor2_name", "action_geo_fullname",
        "event_summary",
    ]


def get_output_schema():
    return pd.DataFrame({
        "post_name":           prep_string(),    # noqa: F821
        "post_country":        prep_string(),    # noqa: F821
