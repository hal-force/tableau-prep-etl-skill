"""
Tableau Prep Script: per-row trend enrichment for event/incident data.

Generated by tableau-prep-etl skill from templates/trend_analyzer.py.j2.

Consumes an upstream dataframe of events (one row per event) and returns
the SAME rows enriched with temporal features, per-dimension trend
statistics, and an anomaly flag. Joining stats back at the row level
lets the analyst land a single Hyper that powers both detail tables
and trend dashboards in Tableau without a desktop-side join.

Configured by spec:
  date_col           = "{{ date_col }}"          (ISO 8601 string column)
  time_col           = "{{ time_col }}"          ("HH:MM" string column or "")
  dimensions         = {{ dimensions | tojson }}
  rolling_window_days= {{ rolling_window_days }}
  anomaly_z          = {{ anomaly_z }}

Per-row outputs:
  year, month, quarter, year_month (YYYY-MM), iso_week, day_of_week_num,
  day_of_week_name, is_weekend, hour_of_day, hour_bucket
  ...for each dimension D in `dimensions`:
    {D}_monthly_count        : count of rows with same D in this row's
                               (year, month) bucket. The hot-/cold-spot
                               signal — a Vaughan "Theft of Motor
                               Vehicle" row carries the count of every
                               other Vaughan auto-theft that month.
    {D}_yoy_change           : (this month - same month prior year)
                               for that D. Negative = trending down.
                               NaN-safe: 0.0 when no prior-year data.
    {D}_yoy_pct              : yoy_change / prior_year_count (capped
                               at +/-10x to avoid div-by-zero blowups
                               that wreck Tableau axes).
    {D}_rolling_count        : count of rows with same D in the
                               trailing {{ rolling_window_days }} days
                               relative to this row's date. Smooths
                               daily noise into a trend signal.
    {D}_baseline_mean        : mean monthly count for this D over the
                               whole input window (the "what's normal"
                               baseline).
    {D}_baseline_std         : standard deviation of monthly counts.
    {D}_zscore               : (monthly_count - baseline_mean)/baseline_std.
                               > anomaly_z = unusually high for this D.
    {D}_lifetime_count       : total rows for this D across the dataset.
    {D}_lifetime_rank        : 1-based rank among all D values
                               (1 = highest volume).
    {D}_pct_of_total         : lifetime_count / total rows.
  is_anomaly                  : True when any dimension's |zscore|
                                exceeds anomaly_z. Quick filter for
                                an "attention list" view.

Why per-row enrichment instead of a separate stats table:
  Tableau crime-analytics dashboards almost always slice/filter by the
  same dimensions used to compute the stats. Joining at extract time
  keeps every viz one-click filterable without the user re-creating a
  blend or relationship — and it costs essentially nothing in row size
  for typical incident volumes (<1M rows).
"""
import math

import numpy as np
import pandas as pd

DATE_COL = "{{ date_col }}"
TIME_COL = "{{ time_col }}"
DIMENSIONS = {{ dimensions | tojson }}
ROLLING_WINDOW_DAYS = {{ rolling_window_days }}
ANOMALY_Z = float({{ anomaly_z }})

# Schema declared by upstream nodes — must match what we pass through.
INPUT_SCHEMA: dict = {{ input_schema | tojson if input_schema is defined else '{}' }}


_DOW_NAMES = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]


def _parse_dates(series: pd.Series) -> pd.Series:
    """Robust date parser. ArcGIS rows already arrive as ISO 8601 strings
    from api_caller's epoch-millis-to-ISO conversion, but some rows may
    be empty or malformed. errors='coerce' yields NaT we filter on."""
    return pd.to_datetime(series, errors="coerce", utc=True)


def _hour_from_time(time_str) -> int:
    """Parse 'HH:MM' to int hour-of-day (0-23). Returns -1 on failure
    so downstream can distinguish 'unknown' from 'midnight'."""
    if time_str is None or (isinstance(time_str, float) and math.isnan(time_str)):
        return -1
    s = str(time_str).strip()
    if not s or ":" not in s:
        return -1
    try:
        h = int(s.split(":", 1)[0])
        if 0 <= h <= 23:
            return h
    except (TypeError, ValueError):
        pass
    return -1


def _hour_bucket(h: int) -> str:
    if h < 0:
        return "Unknown"
    if 5 <= h < 12:
        return "Morning"
    if 12 <= h < 17:
        return "Afternoon"
    if 17 <= h < 21:
        return "Evening"
    return "Night"


def _safe_div(num, den, cap=10.0):
    """Division that survives den=0 and bounds blowups so Tableau's
    auto-axes don't squash everything to a flat line."""
    if den is None or den == 0 or pd.isna(den):
        return 0.0
    v = num / den
    if pd.isna(v):
        return 0.0
    if v > cap:
        return cap
    if v < -cap:
        return -cap
    return float(v)


def analyze_trends(df):
    """Tableau Prep entry. Returns the same row count as the input,
    augmented with temporal features and per-dimension trend stats.
    Output schema declared by `get_output_schema` must match exactly
    or Maestro rejects with `Unable to retrieve results for field`."""
    if df is None or len(df) == 0:
        return _empty_output()

    df = df.copy()
    dates = _parse_dates(df[DATE_COL]) if DATE_COL in df.columns else pd.Series([pd.NaT] * len(df))
    df["_dt"] = dates
    df["year"] = dates.dt.year.fillna(0).astype(int)
    df["month"] = dates.dt.month.fillna(0).astype(int)
    df["quarter"] = dates.dt.quarter.fillna(0).astype(int)
    df["year_month"] = dates.dt.strftime("%Y-%m").fillna("")
    df["iso_week"] = dates.dt.isocalendar().week.fillna(0).astype(int)
    dow_num = dates.dt.dayofweek
    df["day_of_week_num"] = dow_num.fillna(-1).astype(int)
    df["day_of_week_name"] = dow_num.apply(lambda v: _DOW_NAMES[int(v)] if pd.notna(v) and 0 <= int(v) <= 6 else "Unknown")
    df["is_weekend"] = dow_num.apply(lambda v: bool(pd.notna(v) and int(v) >= 5))

    if TIME_COL and TIME_COL in df.columns:
        hours = df[TIME_COL].apply(_hour_from_time)
    else:
        hours = pd.Series([-1] * len(df))
    df["hour_of_day"] = hours.astype(int)
    df["hour_bucket"] = hours.apply(_hour_bucket)

    # --- per-dimension trend stats ---
    # Monthly cube once per dimension: counts indexed by (D, year, month).
    for d in DIMENSIONS:
        if d not in df.columns:
            # Column missing — fill defaults. Better than silently erroring
            # because the dataset *has* a typo'd dim name.
            df[f"{d}_monthly_count"] = 0
            df[f"{d}_yoy_change"] = 0
            df[f"{d}_yoy_pct"] = 0.0
            df[f"{d}_rolling_count"] = 0
            df[f"{d}_baseline_mean"] = 0.0
            df[f"{d}_baseline_std"] = 0.0
            df[f"{d}_zscore"] = 0.0
            df[f"{d}_lifetime_count"] = 0
            df[f"{d}_lifetime_rank"] = 0
            df[f"{d}_pct_of_total"] = 0.0
            continue

        # Monthly counts cube
        ym = df[["year", "month", d]].copy()
        ym["__one"] = 1
        monthly = ym.groupby([d, "year", "month"], dropna=False)["__one"].sum().reset_index(name="cnt")

        cube = {(row[d], int(row["year"]), int(row["month"])): int(row["cnt"]) for _, row in monthly.iterrows()}
        df[f"{d}_monthly_count"] = [
            cube.get((v, y, m), 0)
            for v, y, m in zip(df[d], df["year"], df["month"])
        ]

        # Year-over-year: same dim, same month, prior year.
        # Look up cube directly with (v, y-1, m); writing an intermediate
        # `prior_lookup` keyed off (y-1) silently inverts the direction
        # (you'd be reading next-year's counts as the baseline).
        prior_year_count = [
            cube.get((v, int(y) - 1, int(m)), 0)
            for v, y, m in zip(df[d], df["year"], df["month"])
        ]
        df[f"{d}_yoy_change"] = [
            int(cur) - int(prv)
            for cur, prv in zip(df[f"{d}_monthly_count"], prior_year_count)
        ]
        df[f"{d}_yoy_pct"] = [
            _safe_div(int(cur) - int(prv), int(prv) if prv else 1, cap=10.0) if prv else 0.0
            for cur, prv in zip(df[f"{d}_monthly_count"], prior_year_count)
        ]

        # Baseline = mean/std of monthly counts (over months that had any
        # activity) — gives a sane "is this month unusual" reference.
        baseline = monthly.groupby(d)["cnt"].agg(["mean", "std"]).fillna(0.0)
        bm = baseline["mean"].to_dict()
        bs = baseline["std"].to_dict()
        df[f"{d}_baseline_mean"] = df[d].map(bm).fillna(0.0).astype(float)
        df[f"{d}_baseline_std"] = df[d].map(bs).fillna(0.0).astype(float)
        df[f"{d}_zscore"] = [
            _safe_div(c - mu, sd if sd else 1.0, cap=10.0) if sd else 0.0
            for c, mu, sd in zip(df[f"{d}_monthly_count"],
                                 df[f"{d}_baseline_mean"],
                                 df[f"{d}_baseline_std"])
        ]

        # Rolling N-day count: for each row, count rows with same dim
        # value in the trailing window. Sort once per dim, then walk
        # with two pointers — O(N log N + N) per dim, N=full input size.
        rolling = np.zeros(len(df), dtype=int)
        order = df[["_dt", d]].reset_index().rename(columns={"index": "_orig"}).sort_values(["_dt", "_orig"]).reset_index(drop=True)
        # Group by dim and slide a window
        for dim_val, grp in order.groupby(d, dropna=False):
            grp = grp.sort_values("_dt").reset_index(drop=True)
            ts = grp["_dt"].values
            n = len(grp)
            left = 0
            cutoff = np.timedelta64(ROLLING_WINDOW_DAYS, "D")
            for right in range(n):
                if pd.isna(ts[right]):
                    rolling[grp.iloc[right]["_orig"]] = 0
                    continue
                while left < right and (pd.isna(ts[left]) or ts[right] - ts[left] > cutoff):
                    left += 1
                rolling[grp.iloc[right]["_orig"]] = right - left + 1
        df[f"{d}_rolling_count"] = rolling

        # Lifetime totals + ranks + pct-of-total
        lifetime = df.groupby(d, dropna=False).size().sort_values(ascending=False)
        lc = lifetime.to_dict()
        ranks = {v: i + 1 for i, v in enumerate(lifetime.index)}
        total = int(lifetime.sum()) or 1
        df[f"{d}_lifetime_count"] = df[d].map(lc).fillna(0).astype(int)
        df[f"{d}_lifetime_rank"] = df[d].map(ranks).fillna(0).astype(int)
        df[f"{d}_pct_of_total"] = (df[f"{d}_lifetime_count"] / total).astype(float)

    # is_anomaly: any dimension's |zscore| >= ANOMALY_Z. Bool that
    # populates the analyst's quick-filter for "what's unusual right now".
    z_cols = [f"{d}_zscore" for d in DIMENSIONS if f"{d}_zscore" in df.columns]
    if z_cols:
        df["is_anomaly"] = (df[z_cols].abs() >= ANOMALY_Z).any(axis=1)
    else:
        df["is_anomaly"] = False

    df = df.drop(columns=["_dt"])
    return df


def _empty_output():
    cols = list(INPUT_SCHEMA.keys()) + _added_cols()
    return pd.DataFrame(columns=cols)


def _added_cols():
    base = [
        "year", "month", "quarter", "year_month", "iso_week",
        "day_of_week_num", "day_of_week_name", "is_weekend",
        "hour_of_day", "hour_bucket",
    ]
    for d in DIMENSIONS:
        base.extend([
            f"{d}_monthly_count", f"{d}_yoy_change", f"{d}_yoy_pct",
            f"{d}_rolling_count", f"{d}_baseline_mean", f"{d}_baseline_std",
            f"{d}_zscore", f"{d}_lifetime_count", f"{d}_lifetime_rank",
            f"{d}_pct_of_total",
        ])
    base.append("is_anomaly")
    return base


def _prep_type_for(decl: str):
    decl = (decl or "string").lower()
    if decl == "int":
        return prep_int()  # noqa: F821
    if decl in ("decimal", "float", "double"):
        return prep_decimal()  # noqa: F821
    if decl == "bool":
        return prep_bool()  # noqa: F821
    return prep_string()  # noqa: F821


def get_output_schema():
    schema = {name: _prep_type_for(decl) for name, decl in INPUT_SCHEMA.items()}
    # Temporal features
    schema.update({
        "year":              prep_int(),     # noqa: F821
        "month":             prep_int(),     # noqa: F821
        "quarter":           prep_int(),     # noqa: F821
        "year_month":        prep_string(),  # noqa: F821
        "iso_week":          prep_int(),     # noqa: F821
        "day_of_week_num":   prep_int(),     # noqa: F821
        "day_of_week_name":  prep_string(),  # noqa: F821
        "is_weekend":        prep_bool(),    # noqa: F821
        "hour_of_day":       prep_int(),     # noqa: F821
        "hour_bucket":       prep_string(),  # noqa: F821
    })
    for d in DIMENSIONS:
        schema.update({
            f"{d}_monthly_count":  prep_int(),     # noqa: F821
            f"{d}_yoy_change":     prep_int(),     # noqa: F821
            f"{d}_yoy_pct":        prep_decimal(), # noqa: F821
            f"{d}_rolling_count":  prep_int(),     # noqa: F821
            f"{d}_baseline_mean":  prep_decimal(), # noqa: F821
            f"{d}_baseline_std":   prep_decimal(), # noqa: F821
            f"{d}_zscore":         prep_decimal(), # noqa: F821
            f"{d}_lifetime_count": prep_int(),     # noqa: F821
            f"{d}_lifetime_rank":  prep_int(),     # noqa: F821
            f"{d}_pct_of_total":   prep_decimal(), # noqa: F821
        })
    schema["is_anomaly"] = prep_bool()  # noqa: F821
    return pd.DataFrame(schema)
