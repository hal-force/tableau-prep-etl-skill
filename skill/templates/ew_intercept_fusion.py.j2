"""
Tableau Prep Script: JEWOSC EW intercept -> mission-data fusion.

Generated by tableau-prep-etl skill from templates/ew_intercept_fusion.py.j2.

Consumes one dataframe of ELINT/ES intercept "cuts" (one row per detection,
with MEASURED parametrics: frequency, PRI, pulse width, bearing) and fuses
each cut against a baked-in synthetic Electronic Order of Battle: an emitter
threat-library, an EOB site laydown, and a platform / mission-data-file
coverage table. This is the core Electronic-Warfare-Operational-Support
analytic — correlate intercepts to the threat library, surface ambiguous /
unknown emitters, and flag mission-data reprogramming triggers.

ALL emitter parametrics and the EOB are SYNTHETIC and NOTIONAL — an
unclassified demonstration. NATO-reporting-name style designations are used
for audience resonance; the numbers behind them are invented and are NOT
real emitter characteristics and NOT drawn from any classified source.

Per intercept, the fusion adds:
  match_emitter_id     - best-match library emitter (nearest in parametric space)
  match_nato_name      - its NATO-style designation
  match_system_type    - EW/Surveillance / Acquisition / Engagement / ...
  match_distance       - normalized parametric distance to the best match
  match_quality        - matched / ambiguous / unknown
  is_reprogram_trigger  - True when the cut is unknown/changed vs the library
  assoc_weapon         - notional weapon system associated with the match
  lethality            - none / low / medium / high / critical
  threat_priority      - integer priority carried from the library (0..8)
  nearest_site_id      - closest EOB site carrying the matched emitter
  nearest_site_km      - distance to that site (km)
  affiliation          - RED / BLUE / NEUTRAL of the associated site
  range_nm             - great-circle range from own-ship to the intercept
  bearing_deg          - bearing from own-ship (0=N)
  wez_inner_nm         - notional weapon-engagement-zone inner radius (nm)
  in_wez               - True when range_nm <= WEZ for the matched weapon
  threat_band          - Non-hostile / Search / Track / Engage / Critical
  coverage_gap_count   - how many platform MDFs do NOT recognise this emitter
  uncovered_platforms  - pipe-joined platform_ids blind to this emitter
  own_ship_label       - the own-ship reference label

Pure per-row derivations against baked reference tables; no cross-row
aggregation. Deterministic.

Configured by spec:
  freq_col       = "{{ freq_col }}"
  pri_col        = "{{ pri_col }}"
  pw_col         = "{{ pw_col }}"
  lat_col        = "{{ lat_col }}"
  lon_col        = "{{ lon_col }}"
  own_ship_lat   = {{ own_ship_lat }}
  own_ship_lon   = {{ own_ship_lon }}
  own_ship_label = "{{ own_ship_label }}"
  match_tolerance = {{ match_tolerance }}   (normalized; above this => unknown)
"""
import math

import pandas as pd


FREQ_COL       = "{{ freq_col }}"
PRI_COL        = "{{ pri_col }}"
PW_COL         = "{{ pw_col }}"
LAT_COL        = "{{ lat_col }}"
LON_COL        = "{{ lon_col }}"
OWN_SHIP_LAT   = {{ own_ship_lat }}
OWN_SHIP_LON   = {{ own_ship_lon }}
OWN_SHIP_LABEL = "{{ own_ship_label }}"
MATCH_TOL      = {{ match_tolerance }}

INPUT_SCHEMA: dict = {{ input_schema | pyrepr if input_schema is defined else '{}' }}

# --- Baked synthetic reference data (NOTIONAL) -------------------------------
# Passed in from the spec's synthetic CSVs at generation time via pyrepr, so
# the rendered script is self-contained and deterministic.
EMITTERS: list = {{ emitters | pyrepr }}
EOB_SITES: list = {{ eob_sites | pyrepr }}
PLATFORMS: list = {{ platforms | pyrepr }}

# WEZ (weapon-engagement-zone) inner radius by notional weapon family (nm).
WEZ_NM = {
    "SA-N-long": 100.0,
    "SA-N-med": 70.0,
    "SA-N-legacy": 45.0,
    "SHORAD": 20.0,
    "naval-SAM": 20.0,
    "naval-SSM": 30.0,
    "naval-gun": 12.0,
    "AAM": 40.0,
    "-": 0.0,
}


def _f(v, default=float("nan")):
    try:
        return float(v)
    except (TypeError, ValueError):
        return default


def _haversine_km(lat1, lon1, lat2, lon2):
    try:
        p1, p2 = math.radians(float(lat1)), math.radians(float(lat2))
        dp = math.radians(float(lat2) - float(lat1))
        dl = math.radians(float(lon2) - float(lon1))
        h = math.sin(dp / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
        return 6371.0 * 2 * math.asin(min(1.0, math.sqrt(h)))
    except (TypeError, ValueError):
        return float("nan")


def _bearing_deg(lat1, lon1, lat2, lon2):
    try:
        p1, p2 = math.radians(float(lat1)), math.radians(float(lat2))
        dl = math.radians(float(lon2) - float(lon1))
        y = math.sin(dl) * math.cos(p2)
        x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
        return round((math.degrees(math.atan2(y, x)) + 360) % 360, 1)
    except (TypeError, ValueError):
        return float("nan")


def _parametric_distance(fm, pm, wm, emt):
    """Normalized distance between a measured cut (freq GHz, PRI us, PW us)
    and a library emitter. Each axis normalized by the emitter's own value so
    the match is scale-free. CW/jam emitters (pri=0) skip the PRI axis."""
    ef = _f(emt["centre_freq_ghz"])
    ep = _f(emt["pri_us"])
    ew = _f(emt["pw_us"])
    terms = []
    if ef and not math.isnan(fm):
        terms.append(((fm - ef) / ef) ** 2)
    if ep and pm and not math.isnan(pm):
        terms.append(((pm - ep) / ep) ** 2)
    if ew and wm and not math.isnan(wm):
        terms.append(((wm - ew) / ew) ** 2)
    if not terms:
        return float("inf")
    return math.sqrt(sum(terms) / len(terms))


def _best_match(fm, pm, wm):
    """Return (emitter, distance, second_distance). Nearest library emitter
    in normalized parametric space plus the runner-up (for ambiguity)."""
    scored = sorted(
        ((_parametric_distance(fm, pm, wm, e), e) for e in EMITTERS),
        key=lambda t: t[0],
    )
    if not scored:
        return None, float("inf"), float("inf")
    best_d, best_e = scored[0]
    second_d = scored[1][0] if len(scored) > 1 else float("inf")
    return best_e, best_d, second_d


def _sites_for_emitter(emitter_id):
    return [s for s in EOB_SITES if s.get("emitter_id") == emitter_id]


def _coverage_gap(emitter_id):
    """How many platform MDFs do NOT list this emitter, and which."""
    blind = []
    for p in PLATFORMS:
        cov = set((p.get("coverage_emitters") or "").split("|"))
        if emitter_id not in cov:
            blind.append(p.get("platform_id"))
    return len(blind), blind


def _threat_band(match_quality, lethality, in_wez, range_nm):
    if match_quality == "unknown":
        # An unknown/changed emitter is an intelligence gap; treat as elevated
        # but not confirmed-lethal.
        return "Track"
    leth = (lethality or "none").lower()
    if leth == "critical" and in_wez:
        return "Critical"
    if leth in ("critical", "high") and in_wez:
        return "Engage"
    if leth in ("critical", "high"):
        return "Track"
    if leth == "medium":
        return "Search"
    return "Non-hostile"


def _added_cols():
    return [
        "match_emitter_id", "match_nato_name", "match_system_type",
        "match_distance", "match_quality", "is_reprogram_trigger",
        "assoc_weapon", "lethality", "threat_priority",
        "nearest_site_id", "nearest_site_km", "affiliation",
        "range_nm", "bearing_deg", "wez_inner_nm", "in_wez",
        "threat_band", "coverage_gap_count", "uncovered_platforms",
        "own_ship_label",
    ]


def fuse_intercepts(df):
    if df is None or len(df) == 0:
        return pd.DataFrame(columns=list(INPUT_SCHEMA.keys()) + _added_cols())
    df = df.copy()

    out = {c: [] for c in _added_cols()}
    for _, row in df.iterrows():
        fm = _f(row.get(FREQ_COL))
        pm = _f(row.get(PRI_COL))
        wm = _f(row.get(PW_COL))
        lat = row.get(LAT_COL)
        lon = row.get(LON_COL)

        emt, dist, second = _best_match(fm, pm, wm)

        # Match quality: within tolerance and clearly closer than runner-up
        # => matched; within tolerance but runner-up close => ambiguous;
        # outside tolerance => unknown (reprogramming trigger).
        if emt is None or dist > MATCH_TOL:
            quality = "unknown"
        elif second < dist * 1.5:
            quality = "ambiguous"
        else:
            quality = "matched"
        is_trigger = quality == "unknown"

        if emt is not None and quality != "unknown":
            leth = emt.get("lethality", "none")
            weapon = emt.get("assoc_weapon", "-")
            prio = int(_f(emt.get("priority"), 0))
            match_id = emt.get("emitter_id", "")
            nato = emt.get("nato_name", "")
            stype = emt.get("system_type", "")
            # nearest site carrying this emitter
            sites = _sites_for_emitter(match_id)
            best_site, best_km = None, float("nan")
            for s in sites:
                km = _haversine_km(lat, lon, s.get("lat"), s.get("lon"))
                if math.isnan(best_km) or (not math.isnan(km) and km < best_km):
                    best_km, best_site = km, s
            gap_n, blind = _coverage_gap(match_id)
        else:
            leth, weapon, prio = "unknown", "-", 0
            match_id, nato, stype = "", "UNKNOWN / CHANGED", "unresolved"
            best_site, best_km = None, float("nan")
            gap_n, blind = len(PLATFORMS), [p.get("platform_id") for p in PLATFORMS]

        rng_nm = _haversine_km(OWN_SHIP_LAT, OWN_SHIP_LON, lat, lon) / 1.852
        brg = _bearing_deg(OWN_SHIP_LAT, OWN_SHIP_LON, lat, lon)
        wez = WEZ_NM.get(weapon, 0.0)
        in_wez = (not math.isnan(rng_nm)) and wez > 0 and rng_nm <= wez
        band = _threat_band(quality, leth, in_wez, rng_nm)

        out["match_emitter_id"].append(match_id)
        out["match_nato_name"].append(nato)
        out["match_system_type"].append(stype)
        out["match_distance"].append(round(dist, 4) if dist != float("inf") else None)
        out["match_quality"].append(quality)
        out["is_reprogram_trigger"].append(bool(is_trigger))
        out["assoc_weapon"].append(weapon)
        out["lethality"].append(leth)
        out["threat_priority"].append(prio)
        out["nearest_site_id"].append(best_site.get("site_id") if best_site else "")
        out["nearest_site_km"].append(round(best_km, 1) if not math.isnan(best_km) else None)
        out["affiliation"].append(best_site.get("affiliation") if best_site else "UNKNOWN")
        out["range_nm"].append(round(rng_nm, 1) if not math.isnan(rng_nm) else None)
        out["bearing_deg"].append(brg)
        out["wez_inner_nm"].append(wez)
        out["in_wez"].append(bool(in_wez))
        out["threat_band"].append(band)
        out["coverage_gap_count"].append(gap_n)
        out["uncovered_platforms"].append("|".join(blind))
        out["own_ship_label"].append(OWN_SHIP_LABEL)

    for c in _added_cols():
        df[c] = out[c]

    return _coerce_to_declared_schema(df)


def _coerce_to_declared_schema(df):
    if df is None or len(df) == 0:
        return df
    for col, decl in INPUT_SCHEMA.items():
        if col not in df.columns:
            continue
        d = (decl or "").lower()
        try:
            s = df[col]
            if d in ("datetime", "date"):
                if pd.api.types.is_datetime64_any_dtype(s):
                    fmt = "%Y-%m-%d" if d == "date" else "%Y-%m-%dT%H:%M:%SZ"
                    df[col] = s.dt.strftime(fmt).where(s.notna(), "")
                else:
                    df[col] = s.fillna("").astype(str)
            elif d == "int":
                df[col] = pd.to_numeric(s, errors="coerce").fillna(0).astype("int64")
            elif d in ("decimal", "float", "double"):
                df[col] = pd.to_numeric(s, errors="coerce")
            elif d == "bool":
                df[col] = s.astype("bool")
            else:
                df[col] = s.fillna("").astype(str)
        except Exception:
            continue
    return df


def _prep_type_for(decl: str):
    decl = (decl or "string").lower()
    if decl == "int":
        return prep_int()  # noqa: F821
    if decl in ("decimal", "float", "double"):
        return prep_decimal()  # noqa: F821
    if decl == "bool":
        return prep_bool()  # noqa: F821
    if decl == "date":
        return prep_date()  # noqa: F821
    if decl == "datetime":
        return prep_datetime()  # noqa: F821
    return prep_string()  # noqa: F821


def get_output_schema():
    schema = {name: _prep_type_for(decl) for name, decl in INPUT_SCHEMA.items()}
    schema.update({
        "match_emitter_id":     prep_string(),   # noqa: F821
        "match_nato_name":      prep_string(),   # noqa: F821
        "match_system_type":    prep_string(),   # noqa: F821
        "match_distance":       prep_decimal(),  # noqa: F821
        "match_quality":        prep_string(),   # noqa: F821
        "is_reprogram_trigger": prep_bool(),     # noqa: F821
        "assoc_weapon":         prep_string(),   # noqa: F821
        "lethality":            prep_string(),   # noqa: F821
        "threat_priority":      prep_int(),      # noqa: F821
        "nearest_site_id":      prep_string(),   # noqa: F821
        "nearest_site_km":      prep_decimal(),  # noqa: F821
        "affiliation":          prep_string(),   # noqa: F821
        "range_nm":             prep_decimal(),  # noqa: F821
        "bearing_deg":          prep_decimal(),  # noqa: F821
        "wez_inner_nm":         prep_decimal(),  # noqa: F821
        "in_wez":               prep_bool(),     # noqa: F821
        "threat_band":          prep_string(),   # noqa: F821
        "coverage_gap_count":   prep_int(),      # noqa: F821
        "uncovered_platforms":  prep_string(),   # noqa: F821
        "own_ship_label":       prep_string(),   # noqa: F821
    })
    return pd.DataFrame(schema)
