"""
Tableau Prep Script: corpus-wide statistical anomaly detection.

Generated by tableau-prep-etl skill from templates/statistical_analyst.py.j2.

Operates on the FULL corpus (all rows in one DataFrame) — not per-row.
Computes deterministic anomalies: per-group field completeness, IQR
outliers on numeric columns, format diversity per group key.

Transformations seen in spec: {{ transformations | pyrepr }}
"""
import re
from collections import defaultdict
from statistics import mean, stdev
from typing import Any

import pandas as pd


# Configuration via env vars or hardcoded defaults
GROUP_BY_COL = "{{ group_by_col | default('') }}"  # leave blank to skip per-group analysis


def _iqr_outlier(values, x):
    if len(values) < 4:
        return False, 0.0
    s = sorted(values)
    q1 = s[len(s) // 4]
    q3 = s[(3 * len(s)) // 4]
    iqr = q3 - q1
    if iqr == 0:
        return False, 0.0
    lo, hi = q1 - 1.5 * iqr, q3 + 1.5 * iqr
    if x < lo:
        return True, (lo - x) / max(iqr, 1.0)
    if x > hi:
        return True, (x - hi) / max(iqr, 1.0)
    return False, 0.0


def _severity(deviation, low=1.5, high=3.0):
    if deviation >= high:
        return "high"
    if deviation >= low:
        return "medium"
    return "low"


def _row(dimension, target, metric, observed, expected, deviation, severity, affected, description):
    return {
        "dimension": dimension,
        "target": str(target),
        "metric": metric,
        "observed": str(observed),
        "expected": str(expected),
        "deviation_score": float(deviation),
        "severity": severity,
        "affected_ids": "; ".join(str(a) for a in (affected or [])[:5]),
        "description": description,
    }


def analyze_corpus(df):
    """Tableau Prep entry point."""
    if df is None or len(df) == 0:
        return pd.DataFrame(columns=[
            "dimension", "target", "metric", "observed", "expected",
            "deviation_score", "severity", "affected_ids", "description",
        ])

    rows = []

    # Numeric columns: IQR outlier detection corpus-wide
    numeric_cols = [c for c in df.columns if pd.api.types.is_numeric_dtype(df[c])]
    for col in numeric_cols:
        values = df[col].dropna().tolist()
        if len(values) < 4:
            continue
        for _, r in df.iterrows():
            v = r.get(col)
            if v is None or pd.isna(v):
                continue
            is_out, dev = _iqr_outlier(values, float(v))
            if is_out and dev >= 1.0:
                rid = r.get("invoice_id") or r.get("id") or r.get("filename") or ""
                rows.append(_row(
                    "field", col, "iqr_outlier",
                    f"{float(v):,.4f}",
                    f"q1-q3 over {len(values)} rows",
                    dev, _severity(dev),
                    [str(rid)],
                    f"{col}={float(v):,.4f} outside corpus IQR range (deviation {dev:.2f}× IQR)",
                ))

    # Per-group analysis if a group key is configured
    if GROUP_BY_COL and GROUP_BY_COL in df.columns:
        groups = df.groupby(GROUP_BY_COL)
        # Average row-level missingness per group vs corpus mean
        df_missing = df.isna().sum(axis=1)
        per_group_missing = groups.apply(lambda g: df_missing.loc[g.index].mean())
        corpus_missing = df_missing.mean()
        for grp, val in per_group_missing.items():
            if val > corpus_missing + 1.5:
                affected = df[df[GROUP_BY_COL] == grp].index.tolist()[:5]
                rows.append(_row(
                    "group", grp, "missing_fields_per_row",
                    f"{val:.1f}",
                    f"corpus mean {corpus_missing:.1f}",
                    val - corpus_missing, _severity(val - corpus_missing, low=1.5, high=3.5),
                    affected,
                    f"group '{grp}' missing {val:.1f} fields per row vs corpus mean {corpus_missing:.1f}",
                ))

    if not rows:
        return pd.DataFrame(columns=[
            "dimension", "target", "metric", "observed", "expected",
            "deviation_score", "severity", "affected_ids", "description",
        ])

    out = pd.DataFrame(rows)
    out["deviation_score"] = pd.to_numeric(out["deviation_score"], errors="coerce")
    sev_rank = {"high": 3, "medium": 2, "low": 1}
    out["_sev_rank"] = out["severity"].map(sev_rank).fillna(0)
    out = out.sort_values(["_sev_rank", "deviation_score"], ascending=[False, False]).reset_index(drop=True)
    return out.drop(columns=["_sev_rank"])


