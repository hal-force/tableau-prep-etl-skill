"""
Tableau Prep Script: long-form trend statistics table.

Generated by tableau-prep-etl skill from templates/trend_stats.py.j2.

Consumes the same upstream events dataframe as trend_features and
emits a SEPARATE long-form table — one row per (dimension, value,
year, month) — carrying the trend statistics. Tableau joins this
back to the detail extract on (dimension, value, year, month) when
the analyst wants stats alongside detail.

Why long-form (one column = `dimension`, one = `value`) instead of
wide:
  - Adding a 6th or 10th dimension doesn't widen the schema.
  - Tableau's filter/blend semantics work cleanly when stats stack.
  - Aggregation across dimensions ("show me all hot spots this month")
    is one filter pass, not five.

Configured by spec:
  date_col           = "{{ date_col }}"
  dimensions         = {{ dimensions | pyrepr }}
  rolling_window_days= {{ rolling_window_days }}
  anomaly_z          = {{ anomaly_z }}

Output columns (one row per (dim, value, year, month) bucket):
  dimension          : the dimension name (e.g. "district")
  value              : the dimension value (e.g. "N1")
  year, month        : bucket key (joinable from detail rows)
  monthly_count      : count in this bucket
  yoy_change         : monthly_count - prior-year same-month count
  yoy_pct            : safe-divided yoy_change / prior-year count
  rolling_count      : count in trailing rolling_window_days, anchored
                        at the last day of this bucket
  baseline_mean      : mean monthly count for this dim/value across
                        the input window
  baseline_std       : std of monthly counts
  zscore             : (monthly_count - baseline_mean) / baseline_std
  lifetime_count     : total events for this dim/value across the
                        whole input window (constant per value but
                        included in every row to make Tableau filters
                        easy)
  lifetime_rank      : 1-based rank among all values in this dimension
  pct_of_total       : lifetime_count / sum(lifetime_count) for this
                        dimension
  is_anomaly         : True when |zscore| >= anomaly_z (the same flag
                        as the row-level inline shape, but here
                        bucketed instead of repeated per row)
"""
import pandas as pd

DATE_COL = "{{ date_col }}"
DIMENSIONS = {{ dimensions | pyrepr }}
ROLLING_WINDOW_DAYS = {{ rolling_window_days }}
ANOMALY_Z = float({{ anomaly_z }})


def _parse_dates(series):
    return pd.to_datetime(series, errors="coerce", utc=True)


def _safe_div(num, den, cap=10.0):
    if den is None or den == 0 or pd.isna(den):
        return 0.0
    v = num / den
    if pd.isna(v):
        return 0.0
    if v > cap:
        return cap
    if v < -cap:
        return -cap
    return float(v)


def _empty():
    return pd.DataFrame(columns=[
        "dimension", "value", "year", "month",
        "monthly_count", "yoy_change", "yoy_pct",
        "rolling_count", "baseline_mean", "baseline_std", "zscore",
        "lifetime_count", "lifetime_rank", "pct_of_total", "is_anomaly",
    ])


def build_stats(df):
    """Tableau Prep entry. Returns a long-form stats dataframe."""
    if df is None or len(df) == 0:
        return _empty()

    df = df.copy()
    dates = _parse_dates(df[DATE_COL]) if DATE_COL in df.columns else pd.Series([pd.NaT] * len(df))
    df["_dt"] = dates
    df["_year"] = dates.dt.year.fillna(0).astype(int)
    df["_month"] = dates.dt.month.fillna(0).astype(int)

    out_rows = []
    for d in DIMENSIONS:
        if d not in df.columns:
            continue
        sub = df[[d, "_dt", "_year", "_month"]].copy()
        sub["__one"] = 1

        monthly = (sub.groupby([d, "_year", "_month"], dropna=False)["__one"]
                   .sum().reset_index(name="monthly_count"))

        # Build cube once for prior-year lookup.
        cube = {(row[d], int(row["_year"]), int(row["_month"])): int(row["monthly_count"])
                for _, row in monthly.iterrows()}

        # Lifetime totals + ranks per value within this dimension.
        lifetime = (sub.groupby(d, dropna=False).size()
                    .sort_values(ascending=False))
        total = int(lifetime.sum()) or 1
        lc_map = lifetime.to_dict()
        rank_map = {v: i + 1 for i, v in enumerate(lifetime.index)}

        # Baseline mean/std per dim value across all months.
        baseline = (monthly.groupby(d)["monthly_count"]
                    .agg(["mean", "std"]).fillna(0.0))
        bm_map = baseline["mean"].to_dict()
        bs_map = baseline["std"].to_dict()

        # Rolling window count: last day of each month, count rows in
        # trailing N days for the same dim value. Pre-sort once per dim
        # value, then walk months.
        for _, row in monthly.iterrows():
            v = row[d]
            y = int(row["_year"])
            m = int(row["_month"])
            cnt = int(row["monthly_count"])
            # Skip the synthetic (year=0, month=0) bucket created by
            # _year.fillna(0) for rows whose date failed to parse —
            # pd.Timestamp(year=0,...) raises "year 0 is out of range".
            # Tableau Prep cast nodes upstream can deliver NaT/None
            # values that were unparseable in the original feed; those
            # rows still need to flow through Features but should not
            # contribute a zero-year stats bucket.
            if y < 1 or m < 1 or m > 12:
                continue
            prv = cube.get((v, y - 1, m), 0)
            mu = float(bm_map.get(v, 0.0))
            sd = float(bs_map.get(v, 0.0))
            z = _safe_div(cnt - mu, sd if sd else 1.0, cap=10.0) if sd else 0.0

            # Rolling count: events for this dim value where _dt falls
            # in the trailing N days of (y, m, last day of month).
            anchor = pd.Timestamp(year=y, month=m, day=1, tz="UTC") + pd.offsets.MonthEnd(0)
            window_start = anchor - pd.Timedelta(days=ROLLING_WINDOW_DAYS)
            mask = (sub[d] == v) & (sub["_dt"] >= window_start) & (sub["_dt"] <= anchor)
            rolling = int(mask.sum())

            lc = int(lc_map.get(v, 0))
            out_rows.append({
                "dimension": d,
                "value": v if v is not None else "",
                "year": y,
                "month": m,
                "monthly_count": cnt,
                "yoy_change": cnt - prv,
                "yoy_pct": _safe_div(cnt - prv, prv if prv else 1, cap=10.0) if prv else 0.0,
                "rolling_count": rolling,
                "baseline_mean": mu,
                "baseline_std": sd,
                "zscore": z,
                "lifetime_count": lc,
                "lifetime_rank": int(rank_map.get(v, 0)),
                "pct_of_total": lc / total,
                "is_anomaly": bool(abs(z) >= ANOMALY_Z),
            })

    if not out_rows:
        return _empty()
    return pd.DataFrame(out_rows)


def get_output_schema():
    return pd.DataFrame({
        "dimension":      prep_string(),  # noqa: F821
        "value":          prep_string(),  # noqa: F821
        "year":           prep_int(),     # noqa: F821
        "month":          prep_int(),     # noqa: F821
        "monthly_count":  prep_int(),     # noqa: F821
        "yoy_change":     prep_int(),     # noqa: F821
        "yoy_pct":        prep_decimal(), # noqa: F821
        "rolling_count":  prep_int(),     # noqa: F821
        "baseline_mean":  prep_decimal(), # noqa: F821
        "baseline_std":   prep_decimal(), # noqa: F821
        "zscore":         prep_decimal(), # noqa: F821
        "lifetime_count": prep_int(),     # noqa: F821
        "lifetime_rank":  prep_int(),     # noqa: F821
        "pct_of_total":   prep_decimal(), # noqa: F821
        "is_anomaly":     prep_bool(),    # noqa: F821
    })
