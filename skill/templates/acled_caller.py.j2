"""
Tableau Prep Script: ACLED (Armed Conflict Location & Event Data) API caller.

Generated by tableau-prep-etl skill from templates/acled_caller.py.j2.

Why a dedicated template (vs. api_caller): ACLED's API authenticates via
`email` + `key` query-string parameters, not a Bearer token header.
The shared api_caller assumes Bearer-style auth. ACLED also has a few
quirks worth handling inline (1000-row page cap, integer `count`
metadata, server-side date filter via `event_date_where>=`).

Env vars (loaded from macOS keychain by ~/.tableau-prep-etl/load_env.sh):
  ACLED_EMAIL    — registered email at developer.acleddata.com
  ACLED_API_KEY  — issued API key

Never bake these into the spec or rendered code; they reach this script
only via env at TabPy launch time.

URL: {{ url }}
Format hint: {{ format }}
"""
import json
import os
import ssl
import time
from urllib import error, request as urlrequest
from urllib.parse import urlparse, urlencode

import pandas as pd


API_URL          = {{ url | pyrepr }}
EMAIL_ENV        = {{ extra.get('email_env', 'ACLED_EMAIL') | pyrepr }}
KEY_ENV          = {{ extra.get('api_key_env', 'ACLED_API_KEY') | pyrepr }}
LOOKBACK_DAYS    = {{ extra.get('lookback_days', 90) | pyrepr }}
PAGE_SIZE        = {{ extra.get('page_size', 1000) | pyrepr }}
MAX_PAGES        = {{ extra.get('max_pages', 50) | pyrepr }}
MAX_ROWS         = {{ extra.get('max_rows', 200_000) | pyrepr }}
MAX_RESPONSE_BYTES = {{ extra.get('max_response_bytes', 500_000_000) | pyrepr }}
TIMEOUT_S        = {{ extra.get('timeout_s', 120) | pyrepr }}
MAX_RETRIES      = {{ extra.get('max_retries', 3) | pyrepr }}
VERIFY_SSL       = {{ extra.get('verify_ssl', True) | pyrepr }}
# Optional query refinements forwarded to the ACLED endpoint; each
# becomes a `key=value` pair on the URL. Use this to narrow the pull
# server-side rather than filtering downstream.
EXTRA_QUERY      = {{ extra.get('acled_query_params', {}) | pyrepr }}


def _assert_url_safe(u: str) -> None:
    p = urlparse(u)
    if (p.scheme or "").lower() not in ("http", "https"):
        raise ValueError(f"refusing to fetch URL with scheme {p.scheme!r}")
    h = (p.hostname or "").strip().lower()
    if h in ("localhost", "metadata.google.internal", "metadata.aws.com",
             "metadata.azure.com", "169.254.169.254", "0.0.0.0"):
        raise ValueError(f"refusing to fetch hard-blocked host {h!r}")


{% include 'lib/_ssl_ctx.py.j2' %}


def _read_bounded(resp) -> bytes:
    chunks: list[bytes] = []
    total = 0
    while True:
        chunk = resp.read(1024 * 1024)
        if not chunk:
            break
        total += len(chunk)
        if MAX_RESPONSE_BYTES and total > MAX_RESPONSE_BYTES:
            raise RuntimeError(
                f"response body exceeded MAX_RESPONSE_BYTES "
                f"({total} > {MAX_RESPONSE_BYTES}); aborting fetch"
            )
        chunks.append(chunk)
    return b"".join(chunks)


def _credentials() -> tuple[str, str]:
    email = (os.environ.get(EMAIL_ENV) or "").strip()
    key   = (os.environ.get(KEY_ENV) or "").strip()
    if not email or not key:
        raise RuntimeError(
            f"ACLED credentials missing: set ${EMAIL_ENV} and ${KEY_ENV} "
            "(register a free key at developer.acleddata.com, then save to "
            "the macOS keychain via the load_env.sh recipe)."
        )
    return email, key


def _http_get_json(url: str) -> dict:
    _assert_url_safe(url)
    ctx = _ssl_ctx()
    attempt = 0
    while True:
        req = urlrequest.Request(url, method="GET")
        req.add_header("Accept", "application/json")
        try:
            with urlrequest.urlopen(req, timeout=TIMEOUT_S, context=ctx) as resp:
                return json.loads(_read_bounded(resp).decode("utf-8"))
        except error.HTTPError as e:
            # Permanent 4xx (other than 429) — auth, malformed query, etc.
            # Surface the body so the operator can see the ACLED error msg.
            if e.code != 429 and 400 <= e.code < 500:
                try:
                    body = e.read().decode("utf-8", errors="replace")[:500]
                except Exception:
                    body = ""
                raise RuntimeError(f"ACLED API returned {e.code}: {body}") from None
            if attempt < MAX_RETRIES:
                attempt += 1
                time.sleep(2 ** attempt)
                continue
            raise
        except (error.URLError, TimeoutError):
            if attempt < MAX_RETRIES:
                attempt += 1
                time.sleep(2 ** attempt)
                continue
            raise


def _date_floor_iso(lookback_days: int) -> str:
    """ACLED expects YYYY-MM-DD for date filters. Compute today - N days
    as a string; let pandas handle TZ-naive arithmetic since the API
    is date-resolution only (no intra-day timestamps)."""
    floor = pd.Timestamp.utcnow().normalize() - pd.Timedelta(days=int(lookback_days))
    return floor.strftime("%Y-%m-%d")


def _build_url(page: int) -> str:
    email, key = _credentials()
    qs = {
        "email": email,
        "key": key,
        "limit": int(PAGE_SIZE),
        "page": int(page),
        # Server-side date filter; ACLED's `event_date_where=>=:YYYY-MM-DD`
        # syntax filters server-side and dramatically reduces volume vs.
        # pulling everything and filtering downstream.
        "event_date": _date_floor_iso(int(LOOKBACK_DAYS)),
        "event_date_where": ">=",
    }
    if isinstance(EXTRA_QUERY, dict):
        # Operator-supplied refinements override the defaults above.
        for k, v in EXTRA_QUERY.items():
            qs[str(k)] = v
    sep = "&" if "?" in API_URL else "?"
    return f"{API_URL}{sep}{urlencode(qs)}"


def call_api(df):
    """Tableau Prep entry point. Input `df` is the trigger row; ignored.
    Walks the ACLED paginated endpoint and returns a DataFrame of events
    inside the configured lookback window."""
    all_rows: list = []
    page = 1
    while page <= int(MAX_PAGES):
        doc = _http_get_json(_build_url(page))
        # ACLED responses come back as {"success": True, "count": N,
        # "data": [...]} (or "success": False with an "error" field).
        if isinstance(doc, dict) and doc.get("success") is False:
            raise RuntimeError(
                f"ACLED API error: {doc.get('error') or doc!r}"
            )
        rows = doc.get("data") if isinstance(doc, dict) else None
        if not isinstance(rows, list):
            break
        if not rows:
            break
        all_rows.extend(rows)
        if MAX_ROWS and len(all_rows) >= int(MAX_ROWS):
            all_rows = all_rows[:int(MAX_ROWS)]
            break
        # Under-filled page = last page.
        if len(rows) < int(PAGE_SIZE):
            break
        page += 1

    if not all_rows:
        # Return an empty DataFrame with the schema's column shape so
        # downstream Prep nodes don't see a 0-col frame.
        return pd.DataFrame(columns=list(get_output_schema().columns))

    df_out = pd.DataFrame(all_rows)

    # Normalize the columns we know about so downstream Prep nodes get
    # stable types. ACLED ships latitude/longitude as strings sometimes;
    # fatalities as string '0'/'1'/etc.
    if "latitude" in df_out.columns:
        df_out["latitude"]  = pd.to_numeric(df_out["latitude"],  errors="coerce")
    if "longitude" in df_out.columns:
        df_out["longitude"] = pd.to_numeric(df_out["longitude"], errors="coerce")
    if "fatalities" in df_out.columns:
        df_out["fatalities"] = pd.to_numeric(df_out["fatalities"], errors="coerce").fillna(0).astype("int64")
    if "year" in df_out.columns:
        df_out["year"] = pd.to_numeric(df_out["year"], errors="coerce").fillna(0).astype("int64")

    # Coerce string-shaped numerics to clean strings so prep_string()
    # declarations don't trip Maestro type-mismatch.
    for c in ("event_date", "event_type", "sub_event_type",
              "actor1", "actor2", "assoc_actor_1", "assoc_actor_2",
              "inter1", "inter2", "interaction",
              "civilian_targeting", "iso", "region", "country",
              "admin1", "admin2", "admin3", "location",
              "geo_precision", "source", "source_scale",
              "notes", "tags", "timestamp",
              "event_id_cnty", "disorder_type"):
        if c in df_out.columns:
            df_out[c] = df_out[c].astype(str).where(df_out[c].notna(), "")

    return df_out


def get_output_schema():
    """ACLED v2 standard schema (as of 2024-2026). Not every field is
    populated on every event — most are best-effort. We declare them
    as strings so Maestro doesn't reject when a column is sparse.

    See https://acleddata.com/knowledge-base/codebook/ for the
    authoritative definitions."""
    return pd.DataFrame({
        "event_id_cnty":        prep_string(),    # noqa: F821
        "event_date":           prep_string(),    # noqa: F821
        "year":                 prep_int(),       # noqa: F821
        "time_precision":       prep_string(),    # noqa: F821
        "disorder_type":        prep_string(),    # noqa: F821
        "event_type":           prep_string(),    # noqa: F821
        "sub_event_type":       prep_string(),    # noqa: F821
        "actor1":               prep_string(),    # noqa: F821
        "assoc_actor_1":        prep_string(),    # noqa: F821
        "inter1":               prep_string(),    # noqa: F821
        "actor2":               prep_string(),    # noqa: F821
        "assoc_actor_2":        prep_string(),    # noqa: F821
        "inter2":               prep_string(),    # noqa: F821
        "interaction":          prep_string(),    # noqa: F821
        "civilian_targeting":   prep_string(),    # noqa: F821
        "iso":                  prep_string(),    # noqa: F821
        "region":               prep_string(),    # noqa: F821
        "country":              prep_string(),    # noqa: F821
        "admin1":               prep_string(),    # noqa: F821
        "admin2":               prep_string(),    # noqa: F821
        "admin3":               prep_string(),    # noqa: F821
        "location":             prep_string(),    # noqa: F821
        "latitude":             prep_decimal(),   # noqa: F821
        "longitude":            prep_decimal(),   # noqa: F821
        "geo_precision":        prep_string(),    # noqa: F821
        "source":               prep_string(),    # noqa: F821
