"""
Tableau Prep Script: REST/GraphQL API caller.

Generated by tableau-prep-etl skill from templates/api_caller.py.j2.

URL: {{ url }}
Auth: {{ auth }}
Format hint: {{ format }}
GraphQL: {{ graphql }}
"""
import json
import os
import ssl
import time
from urllib import error, request as urlrequest

import pandas as pd

API_URL = "{{ url }}"
{% if graphql %}
GRAPHQL = True
GRAPHQL_QUERY = """
{{ extra.get('query', '# put your GraphQL query in spec.sources[*].extra.query') }}
"""
{% else %}
GRAPHQL = False
{% endif %}

VERIFY_SSL = {{ extra.get('verify_ssl', True) | default(True) }}
TIMEOUT_S = {{ extra.get('timeout_s', 120) | default(120) }}
MAX_RETRIES = {{ extra.get('max_retries', 3) | default(3) }}


def _ssl_ctx():
    try:
        return ssl.create_default_context() if VERIFY_SSL else ssl._create_unverified_context()
    except Exception:
        return None


def _build_headers():
    headers = {"Content-Type": "application/json"}
    {% if auth == 'api_key' %}
    api_key = os.environ.get("{{ extra.get('api_key_env', 'API_KEY') }}", "")
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"
    {% elif auth == 'basic' %}
    import base64
    user = os.environ.get("{{ extra.get('user_env', 'API_USER') }}", "")
    pwd = os.environ.get("{{ extra.get('pwd_env', 'API_PASSWORD') }}", "")
    if user and pwd:
        token = base64.b64encode(f"{user}:{pwd}".encode()).decode()
        headers["Authorization"] = f"Basic {token}"
    {% endif %}
    return headers


def _http_request(payload=None, method="GET"):
    body = json.dumps(payload).encode("utf-8") if payload else None
    headers = _build_headers()
    ctx = _ssl_ctx()
    attempt = 0
    while True:
        req = urlrequest.Request(API_URL, data=body, method=method)
        for k, v in headers.items():
            req.add_header(k, v)
        try:
            with urlrequest.urlopen(req, timeout=TIMEOUT_S, context=ctx) as resp:
                return json.loads(resp.read().decode("utf-8"))
        except (error.HTTPError, error.URLError, TimeoutError) as e:
            if attempt < MAX_RETRIES:
                attempt += 1
                time.sleep(2 ** attempt)
                continue
            raise


def call_api(df):
    """Tableau Prep entry point. Input df is a trigger row (single 'folder'-like
    column from the rewired local xlsx). We ignore it and pull from the API.
    Output: a DataFrame matching the API's records, schema-inferred."""
    if GRAPHQL:
        data = _http_request({"query": GRAPHQL_QUERY}, method="POST")
        # GraphQL responses nest data under 'data' — caller may need to dig
        # further; we surface the top-level data block.
        rows = data.get("data") or data
    else:
        data = _http_request(method="GET")
        rows = data

    # Normalize to DataFrame. If the response is a list, that's our rows.
    # If a dict, look for common envelope keys.
    if isinstance(rows, dict):
        for key in ("results", "data", "items", "records", "rows"):
            if key in rows and isinstance(rows[key], list):
                rows = rows[key]
                break

    if isinstance(rows, list):
        return pd.DataFrame(rows)
    return pd.DataFrame([{"raw": json.dumps(rows)}])


def get_output_schema():
    # Schema is best-effort. The skill's run_loop verifies the actual columns
    # match what call_api returned, and asks for a refinement if not.
    return pd.DataFrame({
        "id": prep_string(),  # noqa: F821
    })
