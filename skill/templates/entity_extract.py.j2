"""
Tableau Prep Script: spaCy named-entity extraction (long-form).

Generated by tableau-prep-etl skill from templates/entity_extract.py.j2.

Consumes an upstream text table (the WHS CX Comments extract by default)
and emits a LONG entity table — one row per (record, detected entity).
Each row carries the entity surface form, its spaCy label + human-readable
description, a coarse category bucket, the character offsets, and a set of
pass-through context columns (directorate, demographics, sentiment) so the
entities can be sliced in Tableau exactly like the source comments.

Entry function: extract(df) -> DataFrame

Output columns (in order):
  {{ id_col }}          : pass-through record id from upstream (the join key
                          back to the source comments / respondent tables).
  EntityText            : entity surface form exactly as it appears in text.
  EntityNorm            : whitespace-collapsed, casefolded form for grouping
                          (so "Pentagon" and "pentagon" roll up together).
  EntityLabel           : raw spaCy label (ORG, GPE, DATE, ...).
  EntityLabelDesc       : human-readable gloss of the label.
  EntityCategory        : coarse bucket (Organization / Place / Person /
                          Temporal / Numeric / ...), handy for a cleaner
                          first-level breakdown than the 18 fine labels.
  StartChar / EndChar   : character span of the entity in the source text.
  <pass-through cols>   : {{ passthrough | pyrepr }}

TabPy note: spaCy is loaded through a mutable-container cache
(`_NLP_CACHE`), never `global`. TabPy wraps the whole script in a single
`def _user_script(_arg1):`, so a top-level `global` rebind would bind to the
empty real-module namespace and raise NameError; in-place mutation of a
module-level dict resolves correctly through the enclosing scope.

Configured by spec:
  text_col      = "{{ text_col }}"
  id_col        = "{{ id_col }}"
  spacy_model   = "{{ spacy_model }}"
  entity_labels = {{ entity_labels | pyrepr }}   # empty => keep every label
"""
import re

import pandas as pd

TEXT_COL = {{ text_col | pyrepr }}
ID_COL = {{ id_col | pyrepr }}
SPACY_MODEL = {{ spacy_model | pyrepr }}
# List of [column_name, prep_type] pairs to carry through from the source row.
PASSTHROUGH = {{ passthrough | pyrepr }}
# When non-empty, only these spaCy labels are emitted. Empty => keep all.
ENTITY_LABELS = set({{ entity_labels | pyrepr }})

# OntoNotes labels emitted by en_core_web_sm, with human-readable glosses.
_LABEL_DESC = {
    "PERSON": "People, including fictional",
    "NORP": "Nationalities or religious or political groups",
    "FAC": "Buildings, airports, highways, bridges, etc.",
    "ORG": "Companies, agencies, institutions, etc.",
    "GPE": "Countries, cities, states",
    "LOC": "Non-GPE locations (mountain ranges, bodies of water)",
    "PRODUCT": "Objects, vehicles, foods, etc. (not services)",
    "EVENT": "Named hurricanes, battles, wars, sports events, etc.",
    "WORK_OF_ART": "Titles of books, songs, etc.",
    "LAW": "Named documents made into laws",
    "LANGUAGE": "Any named language",
    "DATE": "Absolute or relative dates or periods",
    "TIME": "Times smaller than a day",
    "PERCENT": "Percentage, including '%'",
    "MONEY": "Monetary values, including unit",
    "QUANTITY": "Measurements, as of weight or distance",
    "ORDINAL": "'first', 'second', etc.",
    "CARDINAL": "Numerals that do not fall under another type",
}

# Coarse buckets so the demo can lead with 6-ish categories rather than 18
# fine-grained labels.
_LABEL_CATEGORY = {
    "PERSON": "Person",
    "NORP": "Group",
    "FAC": "Place",
    "ORG": "Organization",
    "GPE": "Place",
    "LOC": "Place",
    "PRODUCT": "Product",
    "EVENT": "Event",
    "WORK_OF_ART": "Work",
    "LAW": "Law",
    "LANGUAGE": "Language",
    "DATE": "Temporal",
    "TIME": "Temporal",
    "PERCENT": "Numeric",
    "MONEY": "Numeric",
    "QUANTITY": "Numeric",
    "ORDINAL": "Numeric",
    "CARDINAL": "Numeric",
}

_WS_RE = re.compile(r"\s+")


# === spaCy model cache (mutable container, never `global`) ===

_NLP_CACHE = {}


def _get_nlp():
    if "nlp" in _NLP_CACHE:
        return _NLP_CACHE["nlp"]
    try:
        import spacy
        # NER only: drop the parser/lemmatizer/tagger to keep it fast.
        # tok2vec (which ner depends on) stays enabled.
        nlp = spacy.load(SPACY_MODEL, disable=["parser", "lemmatizer", "tagger"])
    except Exception as e:
        # Fail the node: an empty entity table is indistinguishable from
        # "no entities found" and would publish as a successful run.
        raise RuntimeError(
            "spaCy model %r could not be loaded in TabPy's interpreter (%s: %s). "
            "Install it there: python -m spacy download %s"
            % (SPACY_MODEL, type(e).__name__, e, SPACY_MODEL)
        ) from e
    _NLP_CACHE["nlp"] = nlp
    return nlp


def _clean_text(val) -> str:
    if val is None or (isinstance(val, float) and pd.isna(val)):
        return ""
    return str(val)


def _norm(text: str) -> str:
    return _WS_RE.sub(" ", str(text)).strip().casefold()


def _as_str(val) -> str:
    if val is None or (isinstance(val, float) and pd.isna(val)):
        return ""
    return str(val)


def _as_decimal(val):
    if val is None or val == "":
        return None
    try:
        f = float(val)
    except (TypeError, ValueError):
        return None
    if f != f:  # NaN
        return None
    return f


def _as_int(val):
    if val is None or val == "":
        return None
    try:
        return int(float(val))
    except (TypeError, ValueError):
        return None


def _coerce(val, typ):
    if typ == "decimal":
        return _as_decimal(val)
    if typ == "int":
        return _as_int(val)
    return _as_str(val)


def _passthrough_values(rec: dict) -> dict:
    out = {}
    for name, typ in PASSTHROUGH:
        out[name] = _coerce(rec.get(name), typ)
    return out


def _out_cols() -> list:
    base = [
        ID_COL, "EntityText", "EntityNorm", "EntityLabel",
        "EntityLabelDesc", "EntityCategory", "StartChar", "EndChar",
    ]
    return base + [name for name, _typ in PASSTHROUGH if name != ID_COL]


_PANDAS_DTYPE = {"int": "int64", "decimal": "float64"}


def _empty():
    """Zero-row frame whose dtypes match get_output_schema()."""
    types = {"StartChar": "int", "EndChar": "int"}
    types.update({name: typ for name, typ in PASSTHROUGH if name != ID_COL})
    return pd.DataFrame({c: pd.Series([], dtype=_PANDAS_DTYPE.get(types.get(c), "object"))
                         for c in _out_cols()})


def extract(df):
    """Tableau Prep entry. Returns a long-form entity table — one row per
    detected named entity, with pass-through context for slicing."""
    if df is None or len(df) == 0:
        return _empty()

    nlp = _get_nlp()
    records = df.to_dict("records")
    texts = [_clean_text(r.get(TEXT_COL)) for r in records]

    rows = []
    for rec, doc in zip(records, nlp.pipe(texts, batch_size=64)):
        rid = _as_str(rec.get(ID_COL))
        ctx = _passthrough_values(rec)
        for ent in doc.ents:
            label = ent.label_
            if ENTITY_LABELS and label not in ENTITY_LABELS:
                continue
            row = {
                ID_COL: rid,
                "EntityText": ent.text,
                "EntityNorm": _norm(ent.text),
                "EntityLabel": label,
                "EntityLabelDesc": _LABEL_DESC.get(label, label),
                "EntityCategory": _LABEL_CATEGORY.get(label, "Other"),
                "StartChar": int(ent.start_char),
                "EndChar": int(ent.end_char),
            }
            row.update(ctx)
            rows.append(row)

    if not rows:
        return _empty()
    out = pd.DataFrame(rows)
    # Enforce a stable column order matching get_output_schema().
    return out[_out_cols()]


def get_output_schema():
    cols = {
        ID_COL:            prep_string(),  # noqa: F821
        "EntityText":      prep_string(),  # noqa: F821
        "EntityNorm":      prep_string(),  # noqa: F821
        "EntityLabel":     prep_string(),  # noqa: F821
        "EntityLabelDesc": prep_string(),  # noqa: F821
        "EntityCategory":  prep_string(),  # noqa: F821
        "StartChar":       prep_int(),     # noqa: F821
        "EndChar":         prep_int(),     # noqa: F821
    }
    for name, typ in PASSTHROUGH:
        if name == ID_COL:
            continue
        if typ == "int":
            cols[name] = prep_int()      # noqa: F821
        elif typ == "decimal":
            cols[name] = prep_decimal()  # noqa: F821
        else:
            cols[name] = prep_string()   # noqa: F821
    return pd.DataFrame(cols)
