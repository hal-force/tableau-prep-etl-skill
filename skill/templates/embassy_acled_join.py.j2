"""
Tableau Prep Script: spatial join of ACLED events to US diplomatic posts.

Generated by tableau-prep-etl skill from
templates/embassy_acled_join.py.j2.

Consumes the ACLED API response dataframe (one row per coded event
within the lookback window) and emits one row per (US diplomatic post,
event) pair where the event lies within the configured haversine radius
of the post and inside the configured lookback window.

Design choice — *no severity / risk scoring* in this flow.

Unlike the GDELT-fed Embassy Threat Monitor, this dataset is consumed
in Tableau by an analyst who is grounding LLM reasoning against
individual events. Pre-scoring would conceal the qualitative signal
(the `notes` paragraph, the named actors, the source publication) that
matters most for that workflow. The flow's job is to:

  * filter to a manageable window (lookback_days + radius_miles),
  * tie each event to its nearest in-range post,
  * compute the few facts that always need pre-computing
    (distance_miles, days_ago),
  * pass through every analyst-relevant ACLED field including `notes`
    verbatim,

…and stop. Posture banding, weighting, and triage live in Tableau.

Per-row outputs added:
  post_name, post_country, post_classification, post_lat, post_lon
  distance_miles  — haversine miles between post and event location
  days_ago        — integer days between today UTC and event_date
"""
from datetime import datetime, timezone
from math import asin, cos, radians, sin, sqrt

import pandas as pd


RADIUS_MILES   = {{ radius_miles }}
LOOKBACK_DAYS  = {{ lookback_days }}

LAT_COL        = "{{ lat_col }}"
LON_COL        = "{{ lon_col }}"
DATE_COL       = "{{ date_col }}"

INPUT_SCHEMA: dict = {{ input_schema | pyrepr if input_schema is defined else '{}' }}


