def _haversine_miles(lat1, lon1, lat2, lon2) -> float:
    R_MI = 3958.7613
    lat1r, lat2r = radians(lat1), radians(lat2)
    dlat = lat2r - lat1r
    dlon = radians(lon2 - lon1)
    a = sin(dlat / 2) ** 2 + cos(lat1r) * cos(lat2r) * sin(dlon / 2) ** 2
    return 2 * R_MI * asin(sqrt(min(1.0, a)))


def _parse_acled_date(v) -> pd.Timestamp:
    """ACLED event_date arrives as 'YYYY-MM-DD'."""
    if v is None or pd.isna(v):
        return pd.NaT
    s = str(v).strip()
    if not s:
        return pd.NaT
    try:
        return pd.to_datetime(s, utc=True, errors="coerce")
    except Exception:
        return pd.NaT


def join_acled_events(df):
    """Spatial-join ACLED events to the embassy roster.

    Output is one row per (event × nearest in-range post). When the
    same event falls within range of multiple posts (rare but possible
    near border posts), each pair emits its own row — that's intentional
    so a post's view reflects everything in its vicinity even if another
    post claims it too. Analysts can dedupe in Tableau on `event_id_cnty`.
    """
    cols_out = _added_cols()
    if df is None or len(df) == 0:
        return pd.DataFrame(columns=cols_out)

    df = df.copy()
    if LAT_COL not in df.columns or LON_COL not in df.columns:
        return pd.DataFrame(columns=cols_out)
    df[LAT_COL] = pd.to_numeric(df[LAT_COL], errors="coerce")
    df[LON_COL] = pd.to_numeric(df[LON_COL], errors="coerce")
    df = df[df[LAT_COL].notna() & df[LON_COL].notna()]

    if DATE_COL in df.columns:
        df["_event_dt"] = df[DATE_COL].apply(_parse_acled_date)
        cutoff = pd.Timestamp(datetime.now(timezone.utc)) - pd.Timedelta(days=int(LOOKBACK_DAYS))
        df = df[df["_event_dt"].notna() & (df["_event_dt"] >= cutoff)]
    else:
        df["_event_dt"] = pd.NaT

    if len(df) == 0:
        return pd.DataFrame(columns=cols_out)

    now = pd.Timestamp(datetime.now(timezone.utc))
    posts = pd.DataFrame(_EMBASSY_ROSTER)

    rows = []
    for _, ev in df.iterrows():
        ev_lat = float(ev[LAT_COL])
        ev_lon = float(ev[LON_COL])
        for _, post in posts.iterrows():
            d = _haversine_miles(post["post_lat"], post["post_lon"], ev_lat, ev_lon)
            if d > RADIUS_MILES:
                continue
            ev_dt = ev.get("_event_dt")
            days_ago = int((now - ev_dt).total_seconds() // 86400) if ev_dt is not None and not pd.isna(ev_dt) else -1
            event_date_str = ev_dt.strftime("%Y-%m-%d") if ev_dt is not None and not pd.isna(ev_dt) else ""

            row = {
                "post_name":           post["post_name"],
                "post_country":        post["post_country"],
                "post_classification": post["post_classification"],
                "post_lat":            float(post["post_lat"]),
                "post_lon":            float(post["post_lon"]),
                "distance_miles":      round(d, 2),
                "days_ago":            days_ago,
                "event_id_cnty":       str(ev.get("event_id_cnty") or ""),
                "event_date":          event_date_str,
                "year":                int(pd.to_numeric(ev.get("year"), errors="coerce") or 0),
                "time_precision":      str(ev.get("time_precision") or ""),
                "disorder_type":       str(ev.get("disorder_type") or ""),
                "event_type":          str(ev.get("event_type") or ""),
                "sub_event_type":      str(ev.get("sub_event_type") or ""),
                "actor1":              str(ev.get("actor1") or ""),
                "assoc_actor_1":       str(ev.get("assoc_actor_1") or ""),
                "inter1":              str(ev.get("inter1") or ""),
                "actor2":              str(ev.get("actor2") or ""),
                "assoc_actor_2":       str(ev.get("assoc_actor_2") or ""),
                "inter2":              str(ev.get("inter2") or ""),
                "interaction":         str(ev.get("interaction") or ""),
                "civilian_targeting":  str(ev.get("civilian_targeting") or ""),
                "iso":                 str(ev.get("iso") or ""),
                "region":              str(ev.get("region") or ""),
                "country":             str(ev.get("country") or ""),
                "admin1":              str(ev.get("admin1") or ""),
                "admin2":              str(ev.get("admin2") or ""),
                "admin3":              str(ev.get("admin3") or ""),
                "location":            str(ev.get("location") or ""),
                "latitude":            ev_lat,
                "longitude":           ev_lon,
                "geo_precision":       str(ev.get("geo_precision") or ""),
                "source":              str(ev.get("source") or ""),
                "source_scale":        str(ev.get("source_scale") or ""),
                "notes":               str(ev.get("notes") or ""),
                "fatalities":          int(pd.to_numeric(ev.get("fatalities"), errors="coerce") or 0),
                "tags":                str(ev.get("tags") or ""),
                "timestamp":           str(ev.get("timestamp") or ""),
            }
            rows.append(row)

    if not rows:
        return pd.DataFrame(columns=cols_out)
    out = pd.DataFrame(rows, columns=cols_out)
    return out


def _added_cols():
    return [
        "post_name", "post_country", "post_classification",
        "post_lat", "post_lon",
        "distance_miles", "days_ago",
        "event_id_cnty", "event_date", "year",
        "time_precision", "disorder_type",
        "event_type", "sub_event_type",
        "actor1", "assoc_actor_1", "inter1",
        "actor2", "assoc_actor_2", "inter2",
        "interaction", "civilian_targeting",
        "iso", "region", "country",
        "admin1", "admin2", "admin3", "location",
        "latitude", "longitude", "geo_precision",
        "source", "source_scale", "notes",
        "fatalities", "tags", "timestamp",
    ]


