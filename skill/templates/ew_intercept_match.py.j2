"""
Tableau Prep Script: JEWOSC EW intercept parametric MATCH (modelling only).

Generated by tableau-prep-etl skill from templates/ew_intercept_match.py.j2.

This is the MODELLING half of the JEWOSC intercept -> mission-data pipeline.
It consumes one dataframe of ELINT/ES intercept "cuts" (one row per detection,
with MEASURED parametrics: frequency, PRI, pulse width) and correlates each cut
against a baked-in emitter FINGERPRINT table by FUZZY parametric match (nearest
emitter in normalized freq/PRI/PW space). Nearest-neighbour matching is NOT an
equality operation, so it cannot be a native Prep SuperJoin — it has to live in
a Script node. That is the ONLY reason anything here is Python.

Everything downstream of the emitter_id this node assigns is FUSION, and is done
with native Prep joins in the flow: the threat-library record, the EOB laydown
rollup, and the platform mission-data-file coverage are three separate input
nodes joined on emitter_id. So the fingerprint baked here is deliberately
minimal — just the numeric signature the nearest-neighbour needs (emitter_id +
centre frequency + PRI + pulse width). The rich attributes arrive via the joins.

ALL emitter parametrics are SYNTHETIC and NOTIONAL — an unclassified
demonstration. NATO-reporting-name style designations (carried by the threat
library join, not here) are used for audience resonance only; the numbers are
invented and are NOT real emitter characteristics.

Per intercept, this node adds:
  emitter_id            - best-match library emitter id ("" when unknown/changed);
                          THIS IS THE JOIN KEY the three reference tables key on
  match_distance        - normalized parametric distance to the best match
  match_second_distance - distance to the runner-up (drives ambiguity)
  match_quality         - matched / ambiguous / unknown
  is_reprogram_trigger  - True when the cut is unknown/changed vs the library
  trigger_cause         - WHY the cut is on the reprogramming queue:
                          novel_emitter / library_ambiguity / correlator_miss
                          ("" for matched cuts) — splits the one queue number
                          into three operationally distinct workloads
  correlator_outcome    - confusion-matrix cell (truth vs correlator call),
                          for the correlator-calibration view
  range_nm              - great-circle range from own-ship to the intercept
  bearing_deg           - bearing from own-ship (0=N)
  own_ship_label        - the own-ship reference label

Pure per-row derivations; no cross-row aggregation, no external table beyond the
baked fingerprint. Deterministic.

Configured by spec:
  freq_col       = "{{ freq_col }}"
  pri_col        = "{{ pri_col }}"
  pw_col         = "{{ pw_col }}"
  lat_col        = "{{ lat_col }}"
  lon_col        = "{{ lon_col }}"
  own_ship_lat   = {{ own_ship_lat }}
  own_ship_lon   = {{ own_ship_lon }}
  own_ship_label = "{{ own_ship_label }}"
  match_tolerance = {{ match_tolerance }}   (normalized; above this => unknown)
"""
import math

import pandas as pd


FREQ_COL       = "{{ freq_col }}"
PRI_COL        = "{{ pri_col }}"
PW_COL         = "{{ pw_col }}"
LAT_COL        = "{{ lat_col }}"
LON_COL        = "{{ lon_col }}"
OWN_SHIP_LAT   = {{ own_ship_lat }}
OWN_SHIP_LON   = {{ own_ship_lon }}
OWN_SHIP_LABEL = "{{ own_ship_label }}"
MATCH_TOL      = {{ match_tolerance }}
# Optional ground-truth label column (synthetic demo only). When present it
# lets the node split the reprogramming queue by CAUSE (novel emitter vs
# library-resolvable ambiguity vs correlator miss) and expose the correlator
# confusion matrix — turning the calibration gap into a demoable feature.
TRUTH_CLASS_COL = "{{ truth_class_col if truth_class_col is defined else '' }}"

INPUT_SCHEMA: dict = {{ input_schema | pyrepr if input_schema is defined else '{}' }}

# --- Baked emitter FINGERPRINT (NOTIONAL) ------------------------------------
# Only the numeric signature the nearest-neighbour match needs: emitter_id plus
# centre frequency / PRI / pulse width. All descriptive attributes (NATO name,
# lethality, weapon, EOB, coverage) are joined downstream in Prep, not baked
# here — that is the point of this split. Passed in via pyrepr at generate time.
FINGERPRINTS: list = {{ fingerprints | pyrepr }}


def _f(v, default=float("nan")):
    try:
        return float(v)
    except (TypeError, ValueError):
        return default


def _haversine_km(lat1, lon1, lat2, lon2):
    try:
        p1, p2 = math.radians(float(lat1)), math.radians(float(lat2))
        dp = math.radians(float(lat2) - float(lat1))
        dl = math.radians(float(lon2) - float(lon1))
        h = math.sin(dp / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
        return 6371.0 * 2 * math.asin(min(1.0, math.sqrt(h)))
    except (TypeError, ValueError):
        return float("nan")


def _bearing_deg(lat1, lon1, lat2, lon2):
    try:
        p1, p2 = math.radians(float(lat1)), math.radians(float(lat2))
        dl = math.radians(float(lon2) - float(lon1))
        y = math.sin(dl) * math.cos(p2)
        x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
        return round((math.degrees(math.atan2(y, x)) + 360) % 360, 1)
    except (TypeError, ValueError):
        return float("nan")


def _parametric_distance(fm, pm, wm, fp):
    """Normalized distance between a measured cut (freq GHz, PRI us, PW us) and a
    library fingerprint. Each axis normalized by the emitter's own value so the
    match is scale-free. CW/jam emitters (pri=0) skip the PRI axis."""
    ef = _f(fp["centre_freq_ghz"])
    ep = _f(fp["pri_us"])
    ew = _f(fp["pw_us"])
    terms = []
    if ef and not math.isnan(fm):
        terms.append(((fm - ef) / ef) ** 2)
    if ep and pm and not math.isnan(pm):
        terms.append(((pm - ep) / ep) ** 2)
    if ew and wm and not math.isnan(wm):
        terms.append(((wm - ew) / ew) ** 2)
    if not terms:
        return float("inf")
    return math.sqrt(sum(terms) / len(terms))


def _best_match(fm, pm, wm):
    """Return (fingerprint, distance, second_distance). Nearest library emitter
    in normalized parametric space plus the runner-up (for ambiguity)."""
    scored = sorted(
        ((_parametric_distance(fm, pm, wm, fp), fp) for fp in FINGERPRINTS),
        key=lambda t: t[0],
    )
    if not scored:
        return None, float("inf"), float("inf")
    best_d, best_fp = scored[0]
    second_d = scored[1][0] if len(scored) > 1 else float("inf")
    return best_fp, best_d, second_d


def _added_cols():
    return [
        "emitter_id", "match_distance", "match_second_distance",
        "match_quality", "is_reprogram_trigger", "trigger_cause",
        "correlator_outcome",
        "range_nm", "bearing_deg", "own_ship_label",
    ]


def _trigger_cause(quality, truth_class):
    """Split the reprogramming queue by CAUSE instead of collapsing every
    unresolved cut into one number. Three operationally distinct causes:
      - novel_emitter          : genuinely not in the library (truth=unknown)
                                 -> the real new-signal reprogramming workload.
      - library_ambiguity      : resolvable against the library but the
                                 de-interleave couldn't separate two close
                                 emitters (truth=ambiguous) -> a library/
                                 tolerance-tuning problem, not a new threat.
      - correlator_miss        : truth says this cut IS a clean library emitter,
                                 but the correlator failed to match it
                                 -> a defect in the correlator, not the library.
      - (empty)                : matched cut, not on the queue.
    Falls back to a quality-only split when no truth column is available."""
    if quality == "matched":
        return ""
    tc = (str(truth_class).strip().lower() if truth_class is not None else "")
    if not tc:
        # No ground truth: best we can do is name the call the correlator made.
        return "unresolved_ambiguous" if quality == "ambiguous" else "unresolved_unknown"
    if tc == "unknown":
        return "novel_emitter"
    if tc == "ambiguous":
        return "library_ambiguity"
    # truth == clean (or anything else) but the correlator didn't cleanly match
    return "correlator_miss"


def _correlator_outcome(quality, truth_class):
    """Confusion-matrix cell: (correlator call) vs (ground truth). Powers the
    'correlator calibration' view — e.g. truth=clean but call=unknown is a
    false-trigger; truth=unknown but call=matched is a missed novel emitter."""
    tc = (str(truth_class).strip().lower() if truth_class is not None else "")
    if not tc:
        return f"call:{quality}"
    return f"truth:{tc}/call:{quality}"


def match_intercepts(df):
    if df is None or len(df) == 0:
        return pd.DataFrame(columns=list(INPUT_SCHEMA.keys()) + _added_cols())
    df = df.copy()

    out = {c: [] for c in _added_cols()}
    for _, row in df.iterrows():
        fm = _f(row.get(FREQ_COL))
        pm = _f(row.get(PRI_COL))
        wm = _f(row.get(PW_COL))
        lat = row.get(LAT_COL)
        lon = row.get(LON_COL)

        fp, dist, second = _best_match(fm, pm, wm)

        # Match quality: within tolerance and clearly closer than runner-up
        # => matched; within tolerance but runner-up close => ambiguous;
        # outside tolerance => unknown (reprogramming trigger). An unknown cut
        # gets emitter_id "" so the downstream leftOuter joins yield NULL
        # enrichment — a threat with no library record IS the trigger signal.
        if fp is None or dist > MATCH_TOL:
            quality = "unknown"
        elif second < dist * 1.5:
            quality = "ambiguous"
        else:
            quality = "matched"
        is_trigger = quality == "unknown"

        truth_class = row.get(TRUTH_CLASS_COL) if TRUTH_CLASS_COL else None
        cause = _trigger_cause(quality, truth_class)
        outcome = _correlator_outcome(quality, truth_class)

        match_id = fp.get("emitter_id", "") if (fp is not None and quality != "unknown") else ""

        rng_nm = _haversine_km(OWN_SHIP_LAT, OWN_SHIP_LON, lat, lon) / 1.852
        brg = _bearing_deg(OWN_SHIP_LAT, OWN_SHIP_LON, lat, lon)

        out["emitter_id"].append(match_id)
        out["match_distance"].append(round(dist, 4) if dist != float("inf") else None)
        out["match_second_distance"].append(round(second, 4) if second != float("inf") else None)
        out["match_quality"].append(quality)
        out["is_reprogram_trigger"].append(bool(is_trigger))
        out["trigger_cause"].append(cause)
        out["correlator_outcome"].append(outcome)
        out["range_nm"].append(round(rng_nm, 1) if not math.isnan(rng_nm) else None)
        out["bearing_deg"].append(brg)
        out["own_ship_label"].append(OWN_SHIP_LABEL)

    for c in _added_cols():
        df[c] = out[c]

    return _coerce_to_declared_schema(df)


def _coerce_to_declared_schema(df):
    if df is None or len(df) == 0:
        return df
    for col, decl in INPUT_SCHEMA.items():
        if col not in df.columns:
            continue
        d = (decl or "").lower()
        try:
            s = df[col]
            if d in ("datetime", "date"):
                # Emit a CLEAN ISO string, then let get_output_schema()
                # declare it prep_datetime()/prep_date() so the Hyper carries
                # a real timestamp. Two traps this handles:
                #  1. TabPy cannot JSON-serialize a pandas Timestamp OBJECT
                #     ("Object of type Timestamp is not JSON serializable"),
                #     so a Script node must hand back a STRING, never a
                #     datetime64 — Prep types it on the way out.
                #  2. Prep's LoadCsv auto-types an ISO timestamp column and
                #     hands it to TabPy via Java ZonedDateTime.toString(),
                #     which appends a zone-name suffix
                #     ("2026-07-25T17:24:57Z[UTC]") that defeats date parsing.
                #     Strip any trailing "[...]" zone name, normalize to a
                #     canonical ISO string. This is what unlocks date math
                #     (YEAR/MONTH/date-range filters) in the published DS.
                cleaned = (
                    s.astype("string")
                     .str.replace(r"\[[^\]]*\]\s*$", "", regex=True)
                     .str.strip()
                )
                parsed = pd.to_datetime(cleaned, errors="coerce", utc=True)
                fmt = "%Y-%m-%d" if d == "date" else "%Y-%m-%dT%H:%M:%SZ"
                df[col] = parsed.dt.strftime(fmt).where(parsed.notna(), "")
            elif d == "int":
                df[col] = pd.to_numeric(s, errors="coerce").fillna(0).astype("int64")
            elif d in ("decimal", "float", "double"):
                df[col] = pd.to_numeric(s, errors="coerce")
            elif d == "bool":
                df[col] = s.astype("bool")
            else:
                df[col] = s.fillna("").astype(str)
        except Exception:
            continue
    return df


def _prep_type_for(decl: str):
    decl = (decl or "string").lower()
    if decl == "int":
        return prep_int()  # noqa: F821
    if decl in ("decimal", "float", "double"):
        return prep_decimal()  # noqa: F821
    if decl == "bool":
        return prep_bool()  # noqa: F821
    if decl == "date":
        return prep_date()  # noqa: F821
    if decl == "datetime":
        return prep_datetime()  # noqa: F821
    return prep_string()  # noqa: F821


def get_output_schema():
    schema = {name: _prep_type_for(decl) for name, decl in INPUT_SCHEMA.items()}
    schema.update({
        "emitter_id":            prep_string(),   # noqa: F821
        "match_distance":        prep_decimal(),  # noqa: F821
        "match_second_distance": prep_decimal(),  # noqa: F821
        "match_quality":         prep_string(),   # noqa: F821
        "is_reprogram_trigger":  prep_bool(),     # noqa: F821
        "trigger_cause":         prep_string(),   # noqa: F821
        "correlator_outcome":    prep_string(),   # noqa: F821
        "range_nm":              prep_decimal(),  # noqa: F821
        "bearing_deg":           prep_decimal(),  # noqa: F821
        "own_ship_label":        prep_string(),   # noqa: F821
    })
    return pd.DataFrame(schema)
