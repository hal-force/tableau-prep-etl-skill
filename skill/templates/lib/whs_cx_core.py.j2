# ==========================================================================
# Codebook-driven decode maps
# ==========================================================================
def _norm_code(v):
    v = str(v).strip()
    if v == "":
        return v
    try:
        f = float(v)
        if f.is_integer():
            return str(int(f))
    except (ValueError, TypeError):
        pass
    return v


def load_codebook(path):
    import csv
    decode, allcomp = {}, {}
    with open(path, newline="", encoding="utf-8-sig") as f:
        rd = csv.reader(f)
        next(rd, None)
        for r in rd:
            if len(r) < 8:
                continue
            qid = (r[2] or "").strip()
            ans_txt = (r[6] or "").strip()
            ans_val = (r[7] or "").strip()
            if qid and ans_val != "":
                decode.setdefault(qid, {})[_norm_code(ans_val)] = ans_txt
            if len(r) >= 10:
                comp_lbl = (r[8] or "").strip()
                comp_val = (r[9] or "").strip()
                if comp_val != "" and comp_lbl:
                    allcomp[_norm_code(comp_val)] = comp_lbl
    return decode, allcomp


# ==========================================================================
# Numeric coercion  ("4", "4.00", " 5 ", "" -> None)
# ==========================================================================
def _num(x):
    if x is None:
        return None
    s = str(x).strip()
    if s == "":
        return None
    try:
        f = float(s)
    except (ValueError, TypeError):
        return None
    return int(f) if f.is_integer() else f


# ==========================================================================
# Load + union the period extracts (by field name)
# ==========================================================================
def load_union():
    frames = []
    for period, fname in PERIOD_FILES.items():
        p = os.path.join(INPUTS_DIR, fname)
        df = pd.read_csv(p, dtype=str, keep_default_na=False)
        df["FY_Q"] = period
        frames.append(df)
    return pd.concat(frames, ignore_index=True, sort=False)


# ==========================================================================
# Decode helpers
# ==========================================================================
def _short_component(label):
    if not label:
        return label
    m = re.search(r"\(([^)]+)\)\s*$", label)
    return m.group(1).strip() if m else label


def decode_series(raw, mapping, blank="Unknown"):
    def d(v):
        code = _norm_code(v)
        if code == "":
            return blank
        return mapping.get(code, "[" + code + "]")
    return raw.map(d)


def build_rolesp(df, base):
    cols = [base] + [base + "_" + s for s in "ABCDEFG"]
    cols = [c for c in cols if c in df.columns]
    if not cols:
        return pd.Series(["Unknown"] * len(df), index=df.index)

    def unite(row):
        vals = []
        for c in cols:
            code = _num(row[c])
            if code in ROLESP_MAP and ROLESP_MAP[code] not in vals:
                vals.append(ROLESP_MAP[code])
        if not vals:
            return "Unknown"
        if "All of the Above" in vals:
            return "All of the Above"
        return ", ".join(vals)

    return df[cols].apply(unite, axis=1)


# ==========================================================================
# Sentiment (self-contained lexicon + negation flip) — CX-tuned
# ==========================================================================
_POS = {
    "good", "great", "excellent", "outstanding", "professional", "helpful", "responsive",
    "quick", "quickly", "fast", "easy", "efficient", "timely", "friendly", "courteous",
    "knowledgeable", "thorough", "satisfied", "pleased", "smooth", "seamless", "wonderful",
    "amazing", "fantastic", "appreciate", "appreciated", "exceptional", "positive", "prompt",
    "impressed", "kind", "supportive", "accommodating", "clear", "reliable",
    "superb", "best", "love", "loved", "perfect", "pleasant", "exceeded", "commendable",
}
_NEG = {
    "bad", "poor", "terrible", "awful", "slow", "delay", "delayed", "delays", "difficult",
    "confusing", "unresponsive", "unhelpful", "frustrating", "frustrated", "disappointed",
    "disappointing", "rude", "unprofessional", "horrible", "worst", "lacking", "problem",
    "problems", "issue", "issues", "complaint", "unclear", "cumbersome", "inefficient",
    "unacceptable", "failed", "fail", "failure", "hard", "broken", "wait", "waiting",
    "ignored", "lack", "impossible", "error", "errors", "mistake", "mistakes", "nightmare",
    "unable",
}
_NEGATORS = {"not", "no", "never", "n't", "without", "hardly", "cannot", "cant", "dont", "doesnt", "didnt"}
_TOKEN = re.compile(r"[a-z']+")


def sentiment(text):
    if not text or not str(text).strip():
        return ("No Comment", 0)
    toks = _TOKEN.findall(str(text).lower())
    if not toks:
        return ("Neutral", 0)
    score = 0
    for i, t in enumerate(toks):
        val = 0
        if t in _POS:
            val = 1
        elif t in _NEG:
            val = -1
        if val != 0:
            window = toks[max(0, i - 3):i]
            if any(w in _NEGATORS for w in window):
                val = -val
            score += val
    if score > 0:
        return ("Positive", score)
    if score < 0:
        return ("Negative", score)
    return ("Neutral", score)


# ==========================================================================
# PII redaction (regex primary; optional spaCy PERSON NER)
# ==========================================================================
_EMAIL = re.compile(r"\b[\w.+-]+@[\w-]+\.[\w.-]+\b")
_PHONE = re.compile(r"\b(?:\+?1[-.\s]?)?(?:\(?\d{3}\)?[-.\s]?)?\d{3}[-.\s]?\d{4}\b")
_SSN = re.compile(r"\b\d{3}-\d{2}-\d{4}\b")
_URL = re.compile(r"\bhttps?://\S+\b")
_HONORIFIC = re.compile(r"\b(?:Mr|Mrs|Ms|Dr|Miss|Sir|Madam|Mx)\.?\s+[A-Z][a-z]+(?:\s+[A-Z][a-z]+)?")

# NOTE: under TabPy the whole rendered script executes as the body of a single
# wrapper function, so any name we rebind here would be a *local* of that wrapper,
# not a true module global. `global _NLP` inside a nested helper would then bind to
# an empty module slot and raise NameError. Use a mutable container that is only
# ever read as a free variable and mutated in place (never rebound) — this resolves
# correctly through the enclosing scope with no `global`/`nonlocal` needed.
_NLP_CACHE = {}


def _get_nlp():
    if "nlp" in _NLP_CACHE:
        return _NLP_CACHE["nlp"]
    nlp = None
    if USE_NER:
        # Fail closed: with NER on, a missing model must stop the run rather
        # than silently publish comments that only had the regex pass.
        try:
            import spacy
            nlp = spacy.load("en_core_web_sm", disable=["parser", "lemmatizer", "tagger"])
        except Exception as e:
            raise RuntimeError(
                "use_ner is on but spaCy model 'en_core_web_sm' could not be loaded "
                "in TabPy's interpreter (%s: %s). Install it there "
                "(python -m spacy download en_core_web_sm) or set use_ner=false."
                % (type(e).__name__, e)
            ) from e
    _NLP_CACHE["nlp"] = nlp
    return nlp


def _regex_redact(s):
    n = 0
    for pat, tag in ((_URL, "[URL]"), (_EMAIL, "[EMAIL]"), (_SSN, "[SSN]"),
                     (_PHONE, "[PHONE]"), (_HONORIFIC, "[NAME]")):
        s, c = pat.subn(tag, s)
        n += c
    return s, n


def redact_many(texts):
    """Redact a list of texts -> [(redacted, count)]. NER runs batched via
    nlp.pipe; NER errors propagate (no silent regex-only fallback)."""
    out = [_regex_redact(str(t)) if t and str(t).strip() else ("", 0) for t in texts]
    nlp = _get_nlp()
    if nlp is not None:
        idx = [i for i, (s, _) in enumerate(out) if s]
        docs = nlp.pipe([out[i][0] for i in idx], batch_size=64)
        for i, doc in zip(idx, docs):
            s, n = out[i]
            spans = [(e.start_char, e.end_char) for e in doc.ents
                     if e.label_ == "PERSON" and "[" not in e.text]
            for a, b in sorted(spans, reverse=True):
                s = s[:a] + "[NAME]" + s[b:]
            out[i] = (s, n + len(spans))
    return out


def redact(text):
    return redact_many([text])[0]


# ==========================================================================
# Decoded demographic frame (respondent grain)
# ==========================================================================
def build_demographics(df, decode, allcomp):
    out = pd.DataFrame(index=df.index)
    out["SubmissionID"] = df["SubmissionID"]
    out["FY_Q"] = df["FY_Q"]
    out["SubmissionDate"] = df.get("SubmissionDate", "")
    out["SubmissionDateISO"] = pd.to_datetime(
        out["SubmissionDate"].replace("", pd.NA), format="%d-%b-%y", errors="coerce"
    ).dt.strftime("%Y-%m-%d").fillna("")

    out["Component"] = decode_series(df["AllComponents"], allcomp)
    out["Component_Short"] = out["Component"].map(_short_component)
    out["MainOrg"] = decode_series(df["@15276"], decode.get("15276", {}))
    out["OSD_Org"] = decode_series(df["@15278"], decode.get("15278", {}))
    out["PayGrade"] = decode_series(df["@15405"], decode.get("15405", {}))
    out["OrgRole"] = decode_series(df["@15375"], decode.get("15375", {}))
    out["Location"] = decode_series(df["@15277"], decode.get("15277", {}))
    out["InternalExternal"] = decode_series(df["InternalvsExternal"], INTERNAL_EXTERNAL_MAP)
    out["NoServicesUsed"] = df["NoServicesUsed"].map(_num) if "NoServicesUsed" in df.columns else None

    def services_used(idx):
        used = []
        for d in DIRECTORATES:
            cols = [c for c in KPI_COLS[d].values() if c in df.columns]
            if any(_num(df.at[idx, c]) is not None for c in cols):
                used.append(d)
        return ", ".join(used) if used else "None"
    out["ServicesUsed"] = [services_used(i) for i in df.index]
    out["ServicesUsedCount"] = out["ServicesUsed"].map(lambda s: 0 if s == "None" else len(s.split(", ")))

    for d, base in ROLESP_BASE.items():
        out[d + "_RoleInService"] = build_rolesp(df, base)
    return out


# ==========================================================================
# Builders (one per output table)
# ==========================================================================
def build_kpi_long(df, demo):
    records = []
    for scope in SCOPES:
        for kpi, col in KPI_COLS[scope].items():
            if col not in df.columns:
                continue
            ktype = KPI_TYPE[kpi]
            vals = df[col].map(_num)
            role_col = scope + "_RoleInService"
            has_role = role_col in demo.columns
            for i in df.index:
                v = vals.at[i]
                # .map() turns _num's None into NaN, so test both.
                if v is None or pd.isna(v):
                    continue
                rec = {
                    "SubmissionID": demo.at[i, "SubmissionID"],
                    "FY_Q": demo.at[i, "FY_Q"],
                    "Directorate": scope,
                    "DirectorateName": DIRECTORATE_LABEL[scope],
                    "KPI": kpi,
                    "KPILabel": KPI_LABEL[kpi],
                    "KPIType": ktype,
                    "ResponseValue": v,
                    "Component": demo.at[i, "Component"],
                    "Component_Short": demo.at[i, "Component_Short"],
                    "PayGrade": demo.at[i, "PayGrade"],
                    "OrgRole": demo.at[i, "OrgRole"],
                    "Location": demo.at[i, "Location"],
                    "InternalExternal": demo.at[i, "InternalExternal"],
                    "RoleInService": demo.at[i, role_col] if has_role else "Unknown",
                    "IsTopBox": None, "IsResponded": 0,
                    "IsPromoter": None, "IsDetractor": None, "NPSDisplay": None,
                }
                if ktype == "top2box":
                    rec["IsTopBox"] = 1 if v in (4, 5) else 0
                    rec["IsResponded"] = 1 if v in (1, 2, 3, 4, 5) else 0
                else:
                    rec["IsResponded"] = 1 if 1 <= v <= 11 else 0
                    rec["IsPromoter"] = 1 if v in (10, 11) else 0
                    rec["IsDetractor"] = 1 if 1 <= v <= 7 else 0
                    rec["NPSDisplay"] = v - 1 if 1 <= v <= 11 else None
                records.append(rec)
    return pd.DataFrame.from_records(records, columns=[c for c, _ in SCHEMAS["kpi_long"]])


def build_comments(df, demo):
    hits = []
    for scope in COMMENT_ORDER:
        col = COMMENT_COLS[scope]
        if col not in df.columns:
            continue
        for i in df.index:
            raw = (df.at[i, col] or "").strip()
            if raw:
                hits.append((scope, i, raw))
    # One batched redaction pass so NER uses nlp.pipe, not one call per comment.
    redacted = redact_many([raw for _, _, raw in hits])
    records = []
    for (scope, i, raw), (red, nred) in zip(hits, redacted):
        role_col = scope + "_RoleInService"
        lbl, sc = sentiment(raw)
        records.append({
            "SubmissionID": demo.at[i, "SubmissionID"],
            "FY_Q": demo.at[i, "FY_Q"],
            "Directorate": scope,
            "DirectorateName": DIRECTORATE_LABEL[scope],
            "CommentType": "Overall Improvement" if scope == "WHS" else "Service Feedback",
            "CommentText": red,
            "CharLength": len(red),
            "RedactionCount": nred,
            "Sentiment": lbl,
            "SentimentScore": sc,
            "Component_Short": demo.at[i, "Component_Short"],
            "PayGrade": demo.at[i, "PayGrade"],
            "Location": demo.at[i, "Location"],
            "InternalExternal": demo.at[i, "InternalExternal"],
            "RoleInService": demo.at[i, role_col] if role_col in demo.columns else "Unknown",
        })
    return pd.DataFrame.from_records(records, columns=[c for c, _ in SCHEMAS["comments"]])


def build_respondent(df, demo):
    out = demo.copy()
    for scope in SCOPES:
        for kpi, col in KPI_COLS[scope].items():
            out[scope + "_" + kpi] = df[col].map(_num) if col in df.columns else None
    return out[[c for c, _ in SCHEMAS["respondent"]]]


def build_summary(kpi_long):
    rows = []
    grp = kpi_long.groupby(["Directorate", "DirectorateName", "KPI", "KPILabel", "KPIType", "FY_Q"])
    for (d, dname, kpi, klabel, ktype, fyq), g in grp:
        n = int(g["IsResponded"].sum())
        if n == 0:
            continue
        if ktype == "top2box":
            score = 100.0 * g["IsTopBox"].sum() / n
            unit = "% Top-2-Box"
        else:
            prom = int(g["IsPromoter"].sum())
            det = int(g["IsDetractor"].sum())
            score = 100.0 * (prom - det) / n
            unit = "NPS (-100..100)"
        rows.append({"Directorate": d, "DirectorateName": dname, "KPI": kpi,
                     "KPILabel": klabel, "KPIType": ktype, "FY_Q": fyq,
                     "Score": round(score, 2), "N": n, "Unit": unit})
    summ = pd.DataFrame(rows)
    if summ.empty:
        return pd.DataFrame(columns=[c for c, _ in SCHEMAS["summary"]])
    piv = summ.pivot_table(index=["Directorate", "KPI"], columns="FY_Q", values="Score").reset_index()
    if CURRENT_PERIOD in piv.columns and PRIOR_PERIOD in piv.columns:
        piv["YoY_Delta"] = (piv[CURRENT_PERIOD] - piv[PRIOR_PERIOD]).round(2)
        summ = summ.merge(piv[["Directorate", "KPI", "YoY_Delta"]], on=["Directorate", "KPI"], how="left")
    else:
        summ["YoY_Delta"] = None
    return summ[[c for c, _ in SCHEMAS["summary"]]]


# ==========================================================================
# Output schemas — (column, type) per variant
# ==========================================================================
def _respondent_schema():
    cols = [
        ("SubmissionID", "string"), ("FY_Q", "string"), ("SubmissionDate", "string"),
        ("SubmissionDateISO", "string"), ("Component", "string"), ("Component_Short", "string"),
        ("MainOrg", "string"), ("OSD_Org", "string"), ("PayGrade", "string"),
        ("OrgRole", "string"), ("Location", "string"), ("InternalExternal", "string"),
        ("NoServicesUsed", "int"), ("ServicesUsed", "string"), ("ServicesUsedCount", "int"),
    ]
    for d in DIRECTORATES:
        cols.append((d + "_RoleInService", "string"))
    for scope in SCOPES:
        for kpi in KPI_COLS[scope]:
            cols.append((scope + "_" + kpi, "decimal"))
    return cols


SCHEMAS = {
    "kpi_long": [
        ("SubmissionID", "string"), ("FY_Q", "string"), ("Directorate", "string"),
        ("DirectorateName", "string"), ("KPI", "string"), ("KPILabel", "string"),
        ("KPIType", "string"), ("ResponseValue", "decimal"), ("Component", "string"),
        ("Component_Short", "string"), ("PayGrade", "string"), ("OrgRole", "string"),
        ("Location", "string"), ("InternalExternal", "string"), ("RoleInService", "string"),
        ("IsTopBox", "decimal"), ("IsResponded", "int"), ("IsPromoter", "decimal"),
        ("IsDetractor", "decimal"), ("NPSDisplay", "decimal"),
    ],
    "comments": [
        ("SubmissionID", "string"), ("FY_Q", "string"), ("Directorate", "string"),
        ("DirectorateName", "string"), ("CommentType", "string"), ("CommentText", "string"),
        ("CharLength", "int"), ("RedactionCount", "int"), ("Sentiment", "string"),
        ("SentimentScore", "int"), ("Component_Short", "string"), ("PayGrade", "string"),
        ("Location", "string"), ("InternalExternal", "string"), ("RoleInService", "string"),
    ],
    "respondent": _respondent_schema(),
    "summary": [
        ("Directorate", "string"), ("DirectorateName", "string"), ("KPI", "string"),
        ("KPILabel", "string"), ("KPIType", "string"), ("FY_Q", "string"),
        ("Score", "decimal"), ("N", "int"), ("Unit", "string"), ("YoY_Delta", "decimal"),
    ],
}


def _prep_type_for(decl):
    if decl == "int":
        return prep_int()  # noqa: F821
    if decl in ("decimal", "float", "double"):
        return prep_decimal()  # noqa: F821
    return prep_string()  # noqa: F821


def _coerce_output(df, schema):
    """Force the produced df to match the declared Prep schema exactly."""
    cols = [c for c, _ in schema]
    if df is None or len(df) == 0:
        return pd.DataFrame({c: pd.Series([], dtype="object") for c in cols})[cols]
    for col, decl in schema:
        if col not in df.columns:
            df[col] = None
        s = df[col]
        if decl == "int":
            df[col] = pd.to_numeric(s, errors="coerce").fillna(0).astype("int64")
        elif decl in ("decimal", "float", "double"):
            df[col] = pd.to_numeric(s, errors="coerce")
        else:
            df[col] = s.where(s.notna(), "").astype(str)
    return df[cols]


def get_output_schema():
    schema = SCHEMAS[VARIANT]
    return pd.DataFrame({col: _prep_type_for(decl) for col, decl in schema})


# ==========================================================================
# Entry point — ignores the trigger df and reads source files fresh, except
# that summary reuses an upstream KPI Long table when it is wired after one.
# ==========================================================================
_KPI_LONG_KEYS = ("Directorate", "DirectorateName", "KPI", "KPILabel", "KPIType", "FY_Q",
                  "IsResponded", "IsTopBox", "IsPromoter", "IsDetractor")


def _is_kpi_long(df):
    return df is not None and len(df) > 0 and all(c in df.columns for c in _KPI_LONG_KEYS)


def transform(df):
    if VARIANT == "summary" and _is_kpi_long(df):
        kpi_long = df.copy()
        for c in ("IsResponded", "IsTopBox", "IsPromoter", "IsDetractor"):
            kpi_long[c] = pd.to_numeric(kpi_long[c], errors="coerce")
        return _coerce_output(build_summary(kpi_long), SCHEMAS["summary"])
    codebook = os.path.join(INPUTS_DIR, CODEBOOK_FILE)
    decode, allcomp = load_codebook(codebook)
    data = load_union()
    demo = build_demographics(data, decode, allcomp)
    if VARIANT == "kpi_long":
        out = build_kpi_long(data, demo)
    elif VARIANT == "comments":
        out = build_comments(data, demo)
    elif VARIANT == "respondent":
        out = build_respondent(data, demo)
    elif VARIANT == "summary":
        out = build_summary(build_kpi_long(data, demo))
    else:
        raise ValueError("unknown VARIANT: " + str(VARIANT))
    return _coerce_output(out, SCHEMAS[VARIANT])
