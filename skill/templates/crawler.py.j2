"""
Tableau Prep Script: web crawler via Crawl4AI.

Generated by tableau-prep-etl skill from templates/crawler.py.j2.

The query string is a Tableau Prep parameter so analysts can change it
without editing the flow. The parameter name is exposed via the Prep
parameters block; the value lands as a column in the input DataFrame.

Engine: {{ engine }}
Query parameter: {{ query_param_name }}
Max results per run: {{ max_results_per_run }}
Domains allowlist: {{ domains_allowlist | tojson }}
"""
import asyncio
import os

import pandas as pd

QUERY_PARAM_NAME = "{{ query_param_name }}"
MAX_RESULTS = {{ max_results_per_run }}
DOMAINS_ALLOWLIST = {{ domains_allowlist | tojson }}


def _read_query(df):
    """Pull the query out of the input DataFrame. Tableau Prep injects
    parameter values as columns when wired via flow `parameters`."""
    if QUERY_PARAM_NAME in df.columns and len(df) > 0:
        v = df[QUERY_PARAM_NAME].iloc[0]
        if v:
            return str(v)
    # Fall back to env var for headless test runs
    return os.environ.get(QUERY_PARAM_NAME.upper(), "")


async def _crawl_async(query: str):
    try:
        from crawl4ai import AsyncWebCrawler
    except ImportError as e:
        raise RuntimeError(
            "crawl4ai not installed in TabPy's Python interpreter. Install with: "
            "<tabpy-python> -m pip install crawl4ai. "
            f"Original error: {e}"
        )

    rows = []
    async with AsyncWebCrawler(verbose=False) as crawler:
        # Crawl4AI provides a query/search workflow; for raw URL crawls
        # use crawler.arun(url=...). The skill's spec includes
        # `domains_allowlist` for filtering.
        result = await crawler.arun(url=f"https://www.google.com/search?q={query}")
        # Extract links
        if hasattr(result, "links") and result.links:
            for link in result.links.get("external", [])[:MAX_RESULTS]:
                href = link.get("href") or ""
                if DOMAINS_ALLOWLIST and not any(d in href for d in DOMAINS_ALLOWLIST):
                    continue
                rows.append({
                    "url": href,
                    "text": link.get("text") or "",
                    "query": query,
                })
    return rows


def crawl(df):
    """Tableau Prep entry point."""
    query = _read_query(df)
    if not query:
        return pd.DataFrame(columns=["url", "text", "query"])

    try:
        rows = asyncio.run(_crawl_async(query))
    except Exception as e:
        return pd.DataFrame([{"url": "", "text": f"crawl error: {type(e).__name__}: {e}", "query": query}])

    return pd.DataFrame(rows, columns=["url", "text", "query"])


def get_output_schema():
    return pd.DataFrame({
        "url": prep_string(),    # noqa: F821
        "text": prep_string(),   # noqa: F821
        "query": prep_string(),  # noqa: F821
    })
