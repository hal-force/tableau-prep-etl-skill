"""
Tableau Prep Script: walk a folder, emit (filename, path, size_bytes) per file.

Format: {{ format }}
"""
from pathlib import Path

import pandas as pd


FOLDER = "{{ folder_path }}"


def walk_folder(df):
    """Tableau Prep entry point."""
    folder = FOLDER
    if "folder" in df.columns and len(df) > 0:
        v = df.iloc[0].get("folder")
        if v:
            folder = str(v)

    rows = []
    for p in sorted(Path(folder).iterdir()):
        if p.is_file():
            rows.append({
                "filename": p.name,
                "path": str(p),
                "size_bytes": float(p.stat().st_size),
            })

    return pd.DataFrame(rows, columns=["filename", "path", "size_bytes"])


def get_output_schema():
    return pd.DataFrame({
        "filename": prep_string(),    # noqa: F821
        "path": prep_string(),        # noqa: F821
        "size_bytes": prep_decimal(), # noqa: F821
    })
