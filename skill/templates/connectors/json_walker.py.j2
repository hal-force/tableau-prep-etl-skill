"""
Tableau Prep Script: walk a folder of JSON files, emit one row per file
with parsed top-level keys flattened.

Generated by tableau-prep-etl skill. Format: {{ format }}
"""
import json
from pathlib import Path

import pandas as pd


FOLDER = "{{ folder_path }}"


def walk_folder(df):
    """Tableau Prep entry point."""
    folder = FOLDER
    if "folder" in df.columns and len(df) > 0:
        v = df.iloc[0].get("folder")
        if v:
            folder = str(v)

    rows = []
    for p in sorted(Path(folder).glob("*.json")):
        try:
            data = json.loads(p.read_text())
        except Exception:
            data = {"_parse_error": True}
        if isinstance(data, list):
            for i, rec in enumerate(data):
                if isinstance(rec, dict):
                    rec_out = {**rec}
                else:
                    rec_out = {"value": rec}
                rec_out["_source_file"] = p.name
                rec_out["_record_index"] = float(i)
                rows.append(rec_out)
        elif isinstance(data, dict):
            data["_source_file"] = p.name
            rows.append(data)

    return pd.DataFrame(rows)


def get_output_schema():
    return pd.DataFrame({
        "_source_file": prep_string(),  # noqa: F821
    })
