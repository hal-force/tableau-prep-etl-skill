"""
Tableau Prep Script: walk a folder of PDFs, emit one row per file with
its path + extracted text.

Generated by tableau-prep-etl skill. For invoice / SF1034 use-cases this
is the foundation step that downstream LLM and form-widget extractors
build on.

Folder: {{ folder_path }}
Format: {{ format }}
"""
import os
from pathlib import Path

import pandas as pd

try:
    import pdfplumber
    PDFPLUMBER_OK = True
except ImportError:
    PDFPLUMBER_OK = False


FOLDER = "{{ folder_path }}"


def walk_folder(df):
    """Tableau Prep entry point."""
    folder = FOLDER
    if "folder" in df.columns and len(df) > 0:
        v = df.iloc[0].get("folder")
        if v:
            folder = str(v)

    rows = []
    for p in sorted(Path(folder).glob("*.pdf")):
        text = ""
        if PDFPLUMBER_OK:
            try:
                with pdfplumber.open(p) as pdf:
                    text = "\n".join(
                        page.extract_text() or "" for page in pdf.pages
                    )
            except Exception:
                pass
        rows.append({
            "filename": p.name,
            "path": str(p),
            "size_bytes": float(p.stat().st_size),
            "raw_text": text,
            "page_count": float(text.count("\f") + (1 if text else 0)),
        })

    return pd.DataFrame(rows, columns=["filename", "path", "size_bytes", "raw_text", "page_count"])


def get_output_schema():
    return pd.DataFrame({
        "filename": prep_string(),    # noqa: F821
        "path": prep_string(),        # noqa: F821
        "size_bytes": prep_decimal(), # noqa: F821
        "raw_text": prep_string(),    # noqa: F821
        "page_count": prep_decimal(), # noqa: F821
    })
