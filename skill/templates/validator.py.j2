"""
Tableau Prep Script: deterministic validator.

Generated by tableau-prep-etl skill from templates/validator.py.j2.

Applies a configurable set of validation rules per row. Rules are
chosen based on which transformations the user requested in the spec:
{{ transformations | pyrepr }}.

This template is intentionally lightweight in v1. As the skill matures
the rule set will expand to include domain packs (e.g. "invoices",
"financial transactions", "geospatial") that swap in tighter rules.
"""
import re
from datetime import datetime

import pandas as pd


# === Built-in rules ===

def _rule_required_fields_present(rec, required: list) -> tuple[bool, str]:
    missing = [k for k in required if rec.get(k) in (None, "")]
    if missing:
        return False, f"missing required: {', '.join(missing)}"
    return True, ""


def _rule_dates_parseable(rec, fields: list) -> tuple[bool, str]:
    failed = []
    for f in fields:
        v = rec.get(f)
        if v in (None, ""):
            continue
        try:
            from dateutil import parser
            parser.parse(str(v), fuzzy=True)
        except Exception:
            failed.append(f"{f}='{v}'")
    if failed:
        return False, f"unparseable dates: {', '.join(failed)}"
    return True, ""


def _rule_numerics_in_range(rec, ranges: dict) -> tuple[bool, str]:
    failed = []
    for f, (lo, hi) in ranges.items():
        v = rec.get(f)
        if v in (None, ""):
            continue
        try:
            x = float(str(v).replace(",", "").replace("$", ""))
        except Exception:
            failed.append(f"{f} not numeric")
            continue
        if lo is not None and x < lo:
            failed.append(f"{f}={x} < {lo}")
        if hi is not None and x > hi:
            failed.append(f"{f}={x} > {hi}")
    if failed:
        return False, "; ".join(failed)
    return True, ""


# === Configuration ===

# Required fields are skill-supplied; left empty by default. Skill's
# generate_flow.py renders this template with concrete required fields
# pulled from the spec's transformations / outputs.
REQUIRED_FIELDS: list = {{ required_fields | default([]) | pyrepr }}
DATE_FIELDS: list = {{ date_fields | default([]) | pyrepr }}
NUMERIC_RANGES: dict = {{ numeric_ranges | default({}) | pyrepr }}
THRESHOLD = {{ threshold | default(0.85) }}


# Skill renders the input schema here so get_output_schema can faithfully
# pass it through alongside the validation columns. Without this, Maestro
# only sees the validator's six columns and the upstream API data is lost.
INPUT_SCHEMA: dict = {{ input_schema | pyrepr if input_schema is defined else '{}' }}


def validate(df):
    """Tableau Prep entry point. One row in → one row out, augmented with
    validation_score and validation_issues. Input columns are preserved
    so downstream nodes / Hyper writers see the original API data."""
    val_cols = [
        "row_id", "validation_score", "n_rules_passed", "n_rules_failed",
        "validation_issues", "needs_review",
    ]
    if df is None or len(df) == 0:
        cols = list(INPUT_SCHEMA.keys()) + val_cols
        return pd.DataFrame(columns=cols)

    id_col = next((c for c in ("invoice_id", "id", "row_id", "filename") if c in df.columns), None)

    val_rows = []
    for _, rec in df.iterrows():
        rec_dict = {k: rec.get(k) for k in df.columns}
        results: list[tuple[bool, str]] = []
        if REQUIRED_FIELDS:
            results.append(_rule_required_fields_present(rec_dict, REQUIRED_FIELDS))
        if DATE_FIELDS:
            results.append(_rule_dates_parseable(rec_dict, DATE_FIELDS))
        if NUMERIC_RANGES:
            results.append(_rule_numerics_in_range(rec_dict, NUMERIC_RANGES))

        n_pass = sum(1 for ok, _ in results if ok)
        n_fail = len(results) - n_pass
        score = (n_pass / len(results)) if results else 1.0
        issues = "; ".join(msg for ok, msg in results if not ok)

        val_rows.append({
            "row_id": str(rec.get(id_col) if id_col else ""),
            "validation_score": float(score),
            "n_rules_passed": float(n_pass),
            "n_rules_failed": float(n_fail),
            "validation_issues": issues,
            "needs_review": "True" if score < THRESHOLD else "False",
        })

    val_df = pd.DataFrame(val_rows, index=df.index)
    out = pd.concat([df.reset_index(drop=True), val_df.reset_index(drop=True)], axis=1)
    for c in ("validation_score", "n_rules_passed", "n_rules_failed"):
        out[c] = pd.to_numeric(out[c], errors="coerce")
    return out


def _prep_type_for(name: str, decl: str):
    decl = (decl or "string").lower()
    if decl == "int":
        return prep_int()  # noqa: F821
    if decl in ("decimal", "float", "double"):
        return prep_decimal()  # noqa: F821
    if decl == "bool":
        return prep_bool()  # noqa: F821
    if decl == "date":
        return prep_date()  # noqa: F821
    if decl == "datetime":
        return prep_datetime()  # noqa: F821
    return prep_string()  # noqa: F821


def get_output_schema():
    schema = {name: _prep_type_for(name, decl) for name, decl in INPUT_SCHEMA.items()}
    schema.update({
        "row_id": prep_string(),              # noqa: F821
        "validation_score": prep_decimal(),   # noqa: F821
        "n_rules_passed": prep_decimal(),     # noqa: F821
        "n_rules_failed": prep_decimal(),     # noqa: F821
        "validation_issues": prep_string(),   # noqa: F821
        "needs_review": prep_string(),        # noqa: F821
    })
    return pd.DataFrame(schema)
