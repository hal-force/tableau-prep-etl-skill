"""
Tableau Prep Script: EOC analyst fire-incident enrichment.

Generated by tableau-prep-etl skill from templates/eoc_fire_metrics.py.j2.

Consumes a single dataframe (one row per incident) and adds the
analyst-facing derived metrics an Emergency Operations Center cares
about: time-since-discovery, daily growth rate, size class banding
(NWCG), containment status banding, jurisdictional rollup keys, and a
one-line human-readable incident summary suitable for tooltip / list
displays.

Pure single-row functions — no cross-row aggregation. For statistical
anomaly callouts, chain the `statistical_analyst` template after this.

Configured by spec:
  size_col         = "{{ size_col }}"          (acres at current state, decimal)
  discovery_col    = "{{ discovery_col }}"     (ISO 8601 string)
  modified_col     = "{{ modified_col }}"      (ISO 8601 string; for staleness)
  containment_col  = "{{ containment_col }}"   (decimal 0..100)
  containment_dt_col = "{{ containment_dt_col }}"  ("" allowed)
  state_col        = "{{ state_col }}"         (e.g. POOState)
  county_col       = "{{ county_col }}"        (e.g. POOCounty)
  agency_col       = "{{ agency_col }}"        (e.g. POOJurisdictionalAgency)
  cause_col        = "{{ cause_col }}"         (e.g. FireCauseGeneral; "" allowed)
  name_col         = "{{ name_col }}"          (e.g. IncidentName)
  type_col         = "{{ type_col }}"          (e.g. IncidentTypeCategory)
  reference_now    = "{{ reference_now }}"     ("" -> wall-clock at exec)

Per-row outputs added:
  days_since_discovery        (decimal, fractional days)
  hours_since_modified        (decimal)
  staleness_band              (string: "Fresh <6h" | "Recent <24h" | "Day-old" |
                                       "Stale 1-3d" | "Old 3-7d" | "Cold >7d")
  acres_per_day               (decimal; uses size_col / days_since_discovery)
  growth_band                 (string: "Quiet" | "Moderate" | "Rapid" | "Explosive")
  size_class                  (string NWCG: "A <0.25ac" | "B 0.25-9ac" |
                                            "C 10-99ac" | "D 100-299ac" |
                                            "E 300-999ac" | "F 1000-4999ac" |
                                            "G 5000+ac")
  containment_band            (string: "Uncontained 0%" | "Initial <25%" |
                                       "Active 25-49%" | "Holding 50-74%" |
                                       "Mostly 75-99%" | "Contained 100%")
  is_active                   (bool: containment < 100 AND no FireOutDateTime)
  region_key                  (string: "{state}/{county}" — choropleth-friendly)
  incident_summary            (string: tooltip-ready 1-liner)
"""
from datetime import datetime, timezone

import pandas as pd


SIZE_COL          = "{{ size_col }}"
DISCOVERY_COL     = "{{ discovery_col }}"
MODIFIED_COL      = "{{ modified_col }}"
CONTAINMENT_COL   = "{{ containment_col }}"
CONTAINMENT_DT_COL= "{{ containment_dt_col }}"
STATE_COL         = "{{ state_col }}"
COUNTY_COL        = "{{ county_col }}"
AGENCY_COL        = "{{ agency_col }}"
CAUSE_COL         = "{{ cause_col }}"
NAME_COL          = "{{ name_col }}"
TYPE_COL          = "{{ type_col }}"
REFERENCE_NOW     = "{{ reference_now }}"
FIRE_OUT_COL      = "{{ fire_out_col | default('FireOutDateTime') }}"

INPUT_SCHEMA: dict = {{ input_schema | tojson if input_schema is defined else '{}' }}


def _now_utc():
    if REFERENCE_NOW:
        try:
            return pd.Timestamp(REFERENCE_NOW).tz_convert("UTC") if pd.Timestamp(REFERENCE_NOW).tzinfo else pd.Timestamp(REFERENCE_NOW, tz="UTC")
        except Exception:
            pass
    return pd.Timestamp(datetime.now(timezone.utc))


def _to_dt(s: pd.Series) -> pd.Series:
    return pd.to_datetime(s, errors="coerce", utc=True)


def _staleness_band(hours: float) -> str:
    if pd.isna(hours) or hours < 0:
        return "Unknown"
    if hours < 6:    return "Fresh <6h"
    if hours < 24:   return "Recent <24h"
    if hours < 48:   return "Day-old"
    if hours < 72:   return "Stale 1-3d"
    if hours < 168:  return "Old 3-7d"
    return "Cold >7d"


def _growth_band(acres_per_day: float) -> str:
    if pd.isna(acres_per_day) or acres_per_day < 0:
        return "Unknown"
    if acres_per_day < 1:     return "Quiet"
    if acres_per_day < 100:   return "Moderate"
    if acres_per_day < 1000:  return "Rapid"
    return "Explosive"


def _size_class(acres) -> str:
    """NWCG fire-size class. Bands are the NWCG-published thresholds."""
    if acres is None or pd.isna(acres) or acres < 0:
        return "Unknown"
    a = float(acres)
    if a < 0.25:   return "A <0.25ac"
    if a < 10:     return "B 0.25-9ac"
    if a < 100:    return "C 10-99ac"
    if a < 300:    return "D 100-299ac"
    if a < 1000:   return "E 300-999ac"
    if a < 5000:   return "F 1000-4999ac"
    return "G 5000+ac"


def _containment_band(pct) -> str:
    if pct is None or pd.isna(pct):
        return "Unknown"
    p = float(pct)
    if p <= 0:    return "Uncontained 0%"
    if p < 25:    return "Initial <25%"
    if p < 50:    return "Active 25-49%"
    if p < 75:    return "Holding 50-74%"
    if p < 100:   return "Mostly 75-99%"
    return "Contained 100%"


def _region_key(state, county) -> str:
    s = ("" if state is None or pd.isna(state) else str(state)).strip()
    c = ("" if county is None or pd.isna(county) else str(county)).strip()
    if s and c: return f"{s}/{c}"
    if s:       return s
    if c:       return c
    return "Unknown"


def _incident_summary(row) -> str:
    """One-liner suitable for a tooltip or list view."""
    name = row.get(NAME_COL) or "(unnamed)"
    state = row.get(STATE_COL) or ""
    county = row.get(COUNTY_COL) or ""
    where = ", ".join(p for p in [county, state] if p) or "Unknown location"
    size = row.get(SIZE_COL)
    sizetxt = f"{float(size):,.0f} acres" if size is not None and not pd.isna(size) else "size unknown"
    cont = row.get(CONTAINMENT_COL)
    conttxt = f"{float(cont):.0f}% contained" if cont is not None and not pd.isna(cont) else "containment unknown"
    cause = row.get(CAUSE_COL) if CAUSE_COL else ""
    causetxt = f", {cause}" if cause and not pd.isna(cause) else ""
    return f"{name} ({where}) — {sizetxt}, {conttxt}{causetxt}"


def add_metrics(df):
    if df is None or len(df) == 0:
        cols = list(INPUT_SCHEMA.keys()) + _added_cols()
        return pd.DataFrame(columns=cols)
    df = df.copy()
    now = _now_utc()
    disc = _to_dt(df[DISCOVERY_COL]) if DISCOVERY_COL in df.columns else pd.Series([pd.NaT] * len(df))
    modd = _to_dt(df[MODIFIED_COL]) if MODIFIED_COL in df.columns else pd.Series([pd.NaT] * len(df))

    days_since = (now - disc).dt.total_seconds() / 86400.0
    df["days_since_discovery"] = days_since.round(2)

    hours_since = (now - modd).dt.total_seconds() / 3600.0
    df["hours_since_modified"] = hours_since.round(2)
    df["staleness_band"] = hours_since.apply(_staleness_band)

    if SIZE_COL in df.columns:
        size_num = pd.to_numeric(df[SIZE_COL], errors="coerce")
        # acres / day (cap at days_since >= 0.5 to avoid divide-by-zero)
        denom = days_since.where(days_since >= 0.5, 0.5)
        df["acres_per_day"] = (size_num / denom).round(2)
        df["size_class"] = size_num.apply(_size_class)
    else:
        df["acres_per_day"] = float("nan")
        df["size_class"] = "Unknown"
    df["growth_band"] = df["acres_per_day"].apply(_growth_band)

    if CONTAINMENT_COL in df.columns:
        cont_num = pd.to_numeric(df[CONTAINMENT_COL], errors="coerce")
        df["containment_band"] = cont_num.apply(_containment_band)
    else:
        cont_num = pd.Series([float("nan")] * len(df))
        df["containment_band"] = "Unknown"

    fire_out = _to_dt(df[FIRE_OUT_COL]) if FIRE_OUT_COL in df.columns else pd.Series([pd.NaT] * len(df))
    df["is_active"] = ((cont_num.fillna(0) < 100) & fire_out.isna()).astype(bool)

    if STATE_COL in df.columns and COUNTY_COL in df.columns:
        df["region_key"] = df.apply(lambda r: _region_key(r.get(STATE_COL), r.get(COUNTY_COL)), axis=1)
    else:
        df["region_key"] = "Unknown"

    df["incident_summary"] = df.apply(_incident_summary, axis=1)
    return _coerce_to_declared_schema(df)


def _coerce_to_declared_schema(df):
    """Cast every input column to its declared Prep type.
    Mirrors trend_features. Without this, Maestro rejects the run with
    'A {type} type is required for field [X]' when the actual pandas
    dtype doesn't match the type declared in `get_output_schema()`."""
    if df is None or len(df) == 0:
        return df
    for col, decl in INPUT_SCHEMA.items():
        if col not in df.columns:
            continue
        d = (decl or "").lower()
        try:
            s = df[col]
            if d in ("datetime", "date"):
                if pd.api.types.is_datetime64_any_dtype(s):
                    fmt = "%Y-%m-%d" if d == "date" else "%Y-%m-%dT%H:%M:%SZ"
                    df[col] = s.dt.strftime(fmt).where(s.notna(), "")
                else:
                    df[col] = s.fillna("").astype(str)
            elif d == "int":
                df[col] = pd.to_numeric(s, errors="coerce").fillna(0).astype("int64")
            elif d in ("decimal", "float", "double"):
                df[col] = pd.to_numeric(s, errors="coerce")
            elif d == "bool":
                df[col] = s.astype("bool")
            else:
                df[col] = s.fillna("").astype(str)
        except Exception:
            continue
    return df


def _added_cols():
    return [
        "days_since_discovery", "hours_since_modified", "staleness_band",
        "acres_per_day", "growth_band", "size_class",
        "containment_band", "is_active", "region_key", "incident_summary",
    ]


def _prep_type_for(decl: str):
    decl = (decl or "string").lower()
    if decl == "int":
        return prep_int()  # noqa: F821
    if decl in ("decimal", "float", "double"):
        return prep_decimal()  # noqa: F821
    if decl == "bool":
        return prep_bool()  # noqa: F821
    if decl == "date":
        return prep_date()  # noqa: F821
    if decl == "datetime":
        return prep_datetime()  # noqa: F821
    return prep_string()  # noqa: F821


def get_output_schema():
    schema = {name: _prep_type_for(decl) for name, decl in INPUT_SCHEMA.items()}
    schema.update({
        "days_since_discovery": prep_decimal(),  # noqa: F821
        "hours_since_modified": prep_decimal(),  # noqa: F821
        "staleness_band":       prep_string(),   # noqa: F821
        "acres_per_day":        prep_decimal(),  # noqa: F821
        "growth_band":          prep_string(),   # noqa: F821
        "size_class":           prep_string(),   # noqa: F821
        "containment_band":     prep_string(),   # noqa: F821
        "is_active":            prep_bool(),     # noqa: F821
        "region_key":           prep_string(),   # noqa: F821
        "incident_summary":     prep_string(),   # noqa: F821
    })
    return pd.DataFrame(schema)
