def _classify(row) -> tuple:
    """Return (emitter_class, confidence) from ADS-B category, callsign and
    velocity/altitude heuristics. Deterministic; no external lookups."""
    cat = ("" if row.get(CATEGORY_COL) is None or pd.isna(row.get(CATEGORY_COL))
           else str(row.get(CATEGORY_COL))).strip()
    cs = ("" if row.get(CALLSIGN_COL) is None or pd.isna(row.get(CALLSIGN_COL))
          else str(row.get(CALLSIGN_COL))).strip().upper()
    try:
        v = float(row.get(VELOCITY_COL))
    except (TypeError, ValueError):
        v = float("nan")
    try:
        a = float(row.get(ALT_COL))
    except (TypeError, ValueError):
        a = float("nan")

    # ADS-B emitter-category strings (from OpenSky JSON `category` when
    # present) map directly.
    catmap = {
        "1": ("transport", 0.75),
        "2": ("transport", 0.75),
        "3": ("transport", 0.90),
        "4": ("transport", 0.90),
        "5": ("transport", 0.85),
        "6": ("fighter", 0.80),
        "7": ("rotary", 0.85),
        "10": ("drone", 0.70),
    }
    if cat in catmap:
        return catmap[cat]

    # Callsign heuristics — military prefixes commonly seen on OpenSky.
    if cs.startswith(("RRR", "ASCOT", "REACH", "COBRA", "IAM", "GAF")):
        return ("transport", 0.65)
    if cs.startswith(("NATO", "AWACS", "MAGIC", "OTIS")):
        return ("awacs", 0.80)
    if cs.startswith(("RAF", "NAVY", "ARMY", "TRENCHANT")):
        return ("isr", 0.60)
    if cs.startswith(("MIRAGE", "TIGER", "TYPHOON", "RAPTOR")):
        return ("fighter", 0.80)

    # Physics-based fallback: high altitude + fast → fighter,
    # low altitude + slow → rotary, medium/slow → transport.
    if not math.isnan(v) and not math.isnan(a):
        if v > 260 and a > 9000:
            return ("fighter", 0.45)
        if v < 90 and a < 3000:
            return ("rotary", 0.50)
        if v > 150:
            return ("transport", 0.40)

    return ("unknown", 0.10)


def _haversine_nm(lat1, lon1, lat2, lon2) -> float:
    """Great-circle distance in nautical miles."""
    try:
        p1, p2 = math.radians(float(lat1)), math.radians(float(lat2))
        dp = math.radians(float(lat2) - float(lat1))
        dl = math.radians(float(lon2) - float(lon1))
        h = math.sin(dp / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
        c = 2 * math.asin(min(1.0, math.sqrt(h)))
        return round(6371.0 * c / 1.852, 2)  # km→nm
    except (TypeError, ValueError):
        return float("nan")


def _bearing_deg(lat1, lon1, lat2, lon2) -> float:
    """Initial forward azimuth in degrees (0..360)."""
    try:
        p1, p2 = math.radians(float(lat1)), math.radians(float(lat2))
        dl = math.radians(float(lon2) - float(lon1))
        y = math.sin(dl) * math.cos(p2)
        x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
        return round((math.degrees(math.atan2(y, x)) + 360) % 360, 2)
    except (TypeError, ValueError):
        return float("nan")


def _aspect_deg(track_heading_deg, bearing_deg) -> float:
    """Aspect: 0 deg means aircraft nose points AT own-ship; 180 means tail-on."""
    try:
        t = float(track_heading_deg)
        b = float(bearing_deg)
        # Reciprocal of bearing from own-ship gives the direction from the
        # aircraft to own-ship. Aspect is angular difference from the aircraft
        # heading vector to that reciprocal.
        recip = (b + 180.0) % 360.0
        diff = abs(t - recip) % 360.0
        return round(min(diff, 360.0 - diff), 2)
    except (TypeError, ValueError):
        return float("nan")


def _rx_dbm(erp_dbw: float, range_nm: float, freq_ghz: float) -> float:
    """Notional received power at an isotropic 0 dBi antenna via Friis.
    Rx_dBm = ERP_dBW + 30 - 20*log10(4*pi*d/lambda). Uses nm→m and GHz→m.
    Returns NaN if geometry or emitter power is missing/zero."""
    try:
        if not erp_dbw or not range_nm or not freq_ghz:
            return float("nan")
        d_m = float(range_nm) * 1852.0
        lam = 0.29979 / float(freq_ghz)  # c / f, metres
        fspl_db = 20.0 * math.log10(4.0 * math.pi * d_m / lam)
        return round(float(erp_dbw) + 30.0 - fspl_db, 2)
    except (TypeError, ValueError, ZeroDivisionError):
        return float("nan")


def _threat_band(mode: str, range_nm: float, rx_dbm: float, aspect_deg: float) -> str:
    """Categorical threat rollup. Illustrative thresholds; the point is to
    demonstrate a decision surface an EW operator can reason about."""
    m = (mode or "silent").lower()
    r = range_nm if range_nm is not None and not (isinstance(range_nm, float) and math.isnan(range_nm)) else 9999.0
    a = aspect_deg if aspect_deg is not None and not (isinstance(aspect_deg, float) and math.isnan(aspect_deg)) else 180.0
    # Silent/passive = non-hostile regardless of geometry
    if m in ("silent", "passive"):
        return "Non-hostile"
    # Target mode + close-in nose-on = critical
    if m == "target" and r < 30 and a < 45:
        return "Critical"
    if m == "target" and r < 80:
        return "Engage"
    if m == "track" and r < 60 and a < 60:
        return "Engage"
    if m == "track":
        return "Track"
    if m == "search":
        return "Search"
    return "Non-hostile"


def _added_cols():
    return [
        "emitter_class", "primary_emitter", "rf_band",
        "centre_freq_ghz", "pri_us", "pw_us", "erp_dbw", "mode",
        "range_nm", "bearing_deg", "aspect_deg", "rx_dbm",
        "threat_band", "fusion_confidence", "own_ship_label",
    ]


def fuse(df):
    if df is None or len(df) == 0:
        return pd.DataFrame(columns=list(INPUT_SCHEMA.keys()) + _added_cols())
    df = df.copy()

    classes, confs = [], []
    for _, row in df.iterrows():
        c, cf = _classify(row)
        classes.append(c)
        confs.append(cf)
    df["emitter_class"] = classes
    df["fusion_confidence"] = confs

    df["primary_emitter"]   = df["emitter_class"].map(lambda c: EOB_LIBRARY.get(c, EOB_LIBRARY["unknown"])["primary_emitter"])
    df["rf_band"]           = df["emitter_class"].map(lambda c: EOB_LIBRARY.get(c, EOB_LIBRARY["unknown"])["rf_band"])
    df["centre_freq_ghz"]   = df["emitter_class"].map(lambda c: EOB_LIBRARY.get(c, EOB_LIBRARY["unknown"])["centre_freq_ghz"])
    df["pri_us"]            = df["emitter_class"].map(lambda c: EOB_LIBRARY.get(c, EOB_LIBRARY["unknown"])["pri_us"])
    df["pw_us"]             = df["emitter_class"].map(lambda c: EOB_LIBRARY.get(c, EOB_LIBRARY["unknown"])["pw_us"])
    df["erp_dbw"]           = df["emitter_class"].map(lambda c: EOB_LIBRARY.get(c, EOB_LIBRARY["unknown"])["erp_dbw"])
    df["mode"]              = df["emitter_class"].map(lambda c: EOB_LIBRARY.get(c, EOB_LIBRARY["unknown"])["mode"])

    # Synthetic mode elevation: a small, deterministic fraction of fighter
    # tracks get promoted to 'target' mode to give the demonstration a
    # visible tail of high-threat rows. Seed off the ICAO24 so results are
    # stable across runs of the same snapshot.
    def _elevate_mode(row):
        cls = row["emitter_class"]
        icao = str(row.get(ICAO_COL) or "")
        if cls == "fighter" and icao:
            rnd = random.Random(icao).random()
            if rnd < 0.05:
                return "target"
            if rnd < 0.20:
                return "track"
        return row["mode"]
    df["mode"] = df.apply(_elevate_mode, axis=1)

    ranges, bearings, aspects, rx = [], [], [], []
    for _, row in df.iterrows():
        lat, lon = row.get(LAT_COL), row.get(LON_COL)
        r = _haversine_nm(OWN_SHIP_LAT, OWN_SHIP_LON, lat, lon)
        b = _bearing_deg(OWN_SHIP_LAT, OWN_SHIP_LON, lat, lon)
        a = _aspect_deg(row.get(HEADING_COL), b)
        rp = _rx_dbm(row.get("erp_dbw"), r, row.get("centre_freq_ghz"))
        ranges.append(r); bearings.append(b); aspects.append(a); rx.append(rp)
    df["range_nm"]   = ranges
    df["bearing_deg"] = bearings
    df["aspect_deg"] = aspects
    df["rx_dbm"]     = rx

    df["threat_band"] = [
        _threat_band(m, r, x, a)
        for m, r, x, a in zip(df["mode"], df["range_nm"], df["rx_dbm"], df["aspect_deg"])
    ]
    df["own_ship_label"] = OWN_SHIP_LABEL

    return _coerce_to_declared_schema(df)


def _coerce_to_declared_schema(df):
    if df is None or len(df) == 0:
        return df
    for col, decl in INPUT_SCHEMA.items():
        if col not in df.columns:
            continue
        d = (decl or "").lower()
        try:
            s = df[col]
            if d in ("datetime", "date"):
                if pd.api.types.is_datetime64_any_dtype(s):
                    fmt = "%Y-%m-%d" if d == "date" else "%Y-%m-%dT%H:%M:%SZ"
                    df[col] = s.dt.strftime(fmt).where(s.notna(), "")
                else:
                    df[col] = s.fillna("").astype(str)
            elif d == "int":
                df[col] = pd.to_numeric(s, errors="coerce").fillna(0).astype("int64")
            elif d in ("decimal", "float", "double"):
                df[col] = pd.to_numeric(s, errors="coerce")
            elif d == "bool":
                df[col] = s.astype("bool")
            else:
                df[col] = s.fillna("").astype(str)
        except Exception:
            continue
    return df


def _prep_type_for(decl: str):
    decl = (decl or "string").lower()
    if decl == "int":
        return prep_int()  # noqa: F821
    if decl in ("decimal", "float", "double"):
        return prep_decimal()  # noqa: F821
    if decl == "bool":
        return prep_bool()  # noqa: F821
    if decl == "date":
        return prep_date()  # noqa: F821
    if decl == "datetime":
        return prep_datetime()  # noqa: F821
    return prep_string()  # noqa: F821


def get_output_schema():
    schema = {name: _prep_type_for(decl) for name, decl in INPUT_SCHEMA.items()}
    schema.update({
        "emitter_class":      prep_string(),   # noqa: F821
        "primary_emitter":    prep_string(),   # noqa: F821
        "rf_band":            prep_string(),   # noqa: F821
        "centre_freq_ghz":    prep_decimal(),  # noqa: F821
        "pri_us":             prep_decimal(),  # noqa: F821
        "pw_us":              prep_decimal(),  # noqa: F821
        "erp_dbw":            prep_decimal(),  # noqa: F821
        "mode":               prep_string(),   # noqa: F821
        "range_nm":           prep_decimal(),  # noqa: F821
        "bearing_deg":        prep_decimal(),  # noqa: F821
        "aspect_deg":         prep_decimal(),  # noqa: F821
        "rx_dbm":             prep_decimal(),  # noqa: F821
        "threat_band":        prep_string(),   # noqa: F821
        "fusion_confidence":  prep_decimal(),  # noqa: F821
        "own_ship_label":     prep_string(),   # noqa: F821
    })
    return pd.DataFrame(schema)
