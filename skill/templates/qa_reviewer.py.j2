"""
Tableau Prep Script: per-document QA reviewer.

Generated by tableau-prep-etl skill from templates/qa_reviewer.py.j2.

Calls the LLM gateway with the canonical extracted record + raw source
text. Returns a severity band, list of issues (field, type, severity,
description), and process-improvement suggestions.

Domain context:
> {{ domain }}

Required env vars: LLM_GATEWAY_URL, LLM_GATEWAY_KEY, LLM_GATEWAY_MODEL.
"""
import hashlib
import json
import os
import re
import ssl
import time
from urllib import error, request as urlrequest

import pandas as pd

GATEWAY_URL = os.environ.get(
    "LLM_GATEWAY_URL",
    "https://your-gateway.example.com/chat/completions",
)
GATEWAY_KEY = os.environ.get("LLM_GATEWAY_KEY", "")
GATEWAY_MODEL = os.environ.get("LLM_GATEWAY_QA_MODEL",
                               os.environ.get("LLM_GATEWAY_MODEL", "claude-sonnet-4-6"))
# Defaults ON. Local dev with self-signed gateways can flip via env.
# Reads at module-import time so a misconfigured gateway fails the
# first call rather than silently MITM-able.
GATEWAY_VERIFY_SSL = (
    os.environ.get("LLM_GATEWAY_VERIFY_SSL", "true").strip().lower() != "false"
)


SYSTEM_PROMPT = """You are a senior QA reviewer for an ETL extraction pipeline.

Domain context:
{{ domain }}

You will receive a record produced by the extraction pipeline plus
optional source text. Your job:

1. Identify SPECIFIC issues — name the field, type of problem, 1-sentence
   description. Severity: 'block' (cannot process), 'high' (wrong data,
   downstream errors), 'medium' (suspicious, needs review), 'low' (cosmetic).
2. Suggest concrete improvements to the EXTRACTION PROCESS that would
   prevent issues like the ones you found. Suggestions are actionable
   for an engineer maintaining the pipeline:
     scope='global' (applies to all extractions),
     scope='source' (specific source has a quirk),
     scope='field' (a specific output field has a recurring issue),
     scope='agent' (a specific extraction step has a flaw).
     target = the slot/field/source the suggestion concerns.

Return ONLY JSON:
{
  "severity_band": "block"|"high"|"medium"|"low"|"clean",
  "severity_score": 0.0-1.0,
  "issues": [
    {"field": "...", "issue_type": "missing|wrong|format|inconsistent|anomaly",
     "description": "...", "severity": "block|high|medium|low"}
  ],
  "improvement_suggestions": [
    {"scope": "global|source|field|agent", "target": "...", "suggestion": "..."}
  ],
  "qa_summary": "short prose, 280 char max"
}

If no issues, return severity_band='clean' with empty arrays.
Be specific. Don't say "improve extraction"; say WHAT to change and WHY.
"""


def _ssl_ctx():
    try:
        return ssl.create_default_context() if GATEWAY_VERIFY_SSL else ssl._create_unverified_context()
    except Exception:
        return None


def _llm_chat(user_msg, max_retries=3, base_delay=1.0):
    if not GATEWAY_KEY or "your-gateway.example.com" in GATEWAY_URL:
        return "", "error:gateway-not-configured"
    payload = {
        "model": GATEWAY_MODEL,
        "messages": [
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": user_msg},
        ],
        "stream": False,
    }
    body = json.dumps(payload).encode()
    ctx = _ssl_ctx()
    attempt = 0
    while True:
        req = urlrequest.Request(GATEWAY_URL, data=body, method="POST")
        req.add_header("Authorization", f"Bearer {GATEWAY_KEY}")
        req.add_header("Content-Type", "application/json")
        try:
            with urlrequest.urlopen(req, timeout=120, context=ctx) as resp:
                data = json.loads(resp.read().decode())
                ch = data.get("choices") or []
                if not ch:
                    return "", "error:no-choices"
                return (ch[0].get("message") or {}).get("content") or "", "ok"
        except (error.HTTPError, error.URLError, TimeoutError) as e:
            if attempt < max_retries:
                attempt += 1
                time.sleep(base_delay * (2 ** attempt))
                continue
            return "", f"error:{type(e).__name__}"


def _strip_fence(s):
    s = s.strip()
    if s.startswith("```"):
        s = re.sub(r"^```[a-zA-Z]*\s*", "", s)
        if s.endswith("```"):
            s = s[: -3]
    return s.strip()


def _parse_json(raw):
    if not raw:
        return {}
    s = _strip_fence(raw)
    m = re.search(r"\{.*\}", s, flags=re.DOTALL)
    if m:
        s = m.group(0)
    try:
        return json.loads(s)
    except json.JSONDecodeError:
        return {}


def _serialize_issues(issues):
    return ";".join(
        f"{i.get('field', '')}|{i.get('issue_type', '')}|"
        f"{str(i.get('description', '')).replace(';', ',')[:200]}|"
        f"{i.get('severity', '')}"
        for i in (issues or [])
    )


def _serialize_suggestions(suggs):
    return ";".join(
        f"{s.get('scope', '')}|{s.get('target', '')}|"
        f"{str(s.get('suggestion', '')).replace(';', ',')[:300]}"
        for s in (suggs or [])
    )


def review_canonical(df):
    """Tableau Prep entry point. Input: canonical record DataFrame."""
    if df is None or len(df) == 0:
        return pd.DataFrame(columns=[
            "row_id", "severity_band", "severity_score",
            "issues_text", "improvement_suggestions_text",
            "qa_summary", "qa_status", "llm_model",
        ])

    # Identify the row identifier column (heuristic).
    id_col = None
    for cand in ("invoice_id", "id", "row_id", "filename"):
        if cand in df.columns:
            id_col = cand
            break

    rows = []
    for _, rec in df.iterrows():
        rec_dict = {k: (None if pd.isna(v) else v) for k, v in rec.items()}
        user_msg = (
            "Record:\n" + json.dumps(rec_dict, indent=2, default=str)
            + "\n\nReturn the JSON QA verdict now."
        )
        raw, status = _llm_chat(user_msg)
        parsed = _parse_json(raw) if status == "ok" else {}

        rows.append({
            "row_id": str(rec.get(id_col) if id_col else ""),
            "severity_band": str(parsed.get("severity_band") or "clean"),
            "severity_score": float(parsed.get("severity_score") or 0.0),
            "issues_text": _serialize_issues(parsed.get("issues") or []),
            "improvement_suggestions_text": _serialize_suggestions(
                parsed.get("improvement_suggestions") or []
            ),
            "qa_summary": str(parsed.get("qa_summary") or "")[:280],
            "qa_status": status,
            "llm_model": GATEWAY_MODEL,
        })

    out = pd.DataFrame(rows)
    out["severity_score"] = pd.to_numeric(out["severity_score"], errors="coerce")
    return out


