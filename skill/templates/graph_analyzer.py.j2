"""
Tableau Prep Script: graph layout + centrality analyzer.

Generated by tableau-prep-etl skill from templates/graph_analyzer.py.j2.

Consumes an upstream edge dataframe with these columns:

  - {{ source_id_col }} : start-node identifier (string)
  - {{ target_id_col }} : end-node identifier (string)
  - start_lon, start_lat : geographic coords of the start endpoint
  - end_lon,   end_lat   : geographic coords of the end endpoint
  - any other edge attributes (carried through to output rows)

Emits ONE ROW PER ENDPOINT (i.e. two rows per edge). The output is
shaped so a single Tableau Prep extract can render lines on a map
*and* power node-centrality tooltips/colors:

  edge_id               : surrogate id (1..N)
  path_order            : 1 = start endpoint, 2 = end endpoint
  node_id               : the substation/router/etc. id at this endpoint
  longitude, latitude   : geographic coords (used for the line)
  layout_x, layout_y    : Fruchterman-Reingold force-directed coords
                          (seeded by geography so the picture stays
                          recognizable while declustering high-degree
                          hubs)
  degree_centrality
  betweenness_centrality
  eigenvector_centrality
  pagerank
  closeness_centrality
  ... plus all the original edge attributes ...

Why this shape:
  Tableau renders lines from a single table by drawing a polyline
  through a path-order field for each edge_id. Centrality metrics on
  the node attach naturally as Detail/Color encodings via node_id.
  This avoids needing a separate node table that gets joined back —
  the join is materialized here once and shipped as a single Hyper.

Layout choice — Fruchterman-Reingold (`spring_layout`) seeded by
geography:
  - {{ layout_iterations }} iterations is plenty for ~10k-edge graphs.
  - `pos` seed = (lon, lat) so the layout starts geographic and only
    perturbs to relax cluttered hubs. This keeps the grid recognizable
    (Texas still looks like Texas) but reduces overplotting.
  - Fixed scale = 10 keeps the result a tame number we can display
    next to lat/lon without dwarfing it.

Centrality choices:
  - degree:        baseline; how many edges each node has
  - betweenness:   bottleneck identification (cascade-failure risk)
  - eigenvector:   recursive importance — being connected to important
                   nodes matters. Requires a connected component.
                   Fails on isolates; we compute per-largest-component
                   and zero-fill the rest.
  - pagerank:      stabilized eigenvector-flavored metric (handles
                   disconnected graphs); good fallback for ranking.
  - closeness:     average shortest-path distance; expensive on large
                   graphs (we cap with `closeness_subset_size` for
                   k-sample approximation when N > {{ closeness_full_threshold }}).
"""
import math

import networkx as nx
import pandas as pd

SOURCE_COL = {{ source_id_col | tojson }}
TARGET_COL = {{ target_id_col | tojson }}
LAYOUT_ITERATIONS = {{ layout_iterations }}
LAYOUT_SCALE = {{ layout_scale }}
LAYOUT_SEED_FROM_GEOGRAPHY = {{ layout_seed_from_geography }}
CLOSENESS_FULL_THRESHOLD = {{ closeness_full_threshold }}

# Schema declared by upstream nodes (validator INPUT_SCHEMA-style).
# Every key here is preserved in the output (twice — once per endpoint)
# so the Hyper writer doesn't drop edge attributes.
INPUT_SCHEMA: dict = {{ input_schema | tojson if input_schema is defined else '{}' }}


def _node_coords_from_edges(df: pd.DataFrame) -> dict:
    """Build node_id → (lon, lat) by averaging endpoint coords.
    Substations appear at the same coords across every edge they
    terminate, so an average is a no-op for clean data and a
    reasonable point estimate for noisy data."""
    coords: dict = {}
    counts: dict = {}
    for _, r in df.iterrows():
        for nid_col, lon_col, lat_col in (
            (SOURCE_COL, "start_lon", "start_lat"),
            (TARGET_COL, "end_lon", "end_lat"),
        ):
            nid = r.get(nid_col)
            if nid in (None, "") or pd.isna(nid):
                continue
            try:
                lon = float(r.get(lon_col))
                lat = float(r.get(lat_col))
            except (TypeError, ValueError):
                continue
            if not (math.isfinite(lon) and math.isfinite(lat)):
                continue
            cur_lon, cur_lat = coords.get(nid, (0.0, 0.0))
            n = counts.get(nid, 0)
            coords[nid] = ((cur_lon * n + lon) / (n + 1),
                           (cur_lat * n + lat) / (n + 1))
            counts[nid] = n + 1
    return coords


def _safe_eigenvector(g: nx.Graph) -> dict:
    """Eigenvector centrality on the largest connected component;
    0 elsewhere. NetworkX's power-iteration form fails to converge
    on disconnected graphs, so we use scipy variant when available
    and fall back to power-iteration on the giant component."""
    if g.number_of_nodes() == 0:
        return {}
    components = list(nx.connected_components(g))
    if not components:
        return {n: 0.0 for n in g.nodes()}
    biggest = max(components, key=len)
    sub = g.subgraph(biggest)
    try:
        ev = nx.eigenvector_centrality_numpy(sub, weight=None)
    except Exception:
        try:
            ev = nx.eigenvector_centrality(sub, max_iter=1000, tol=1e-04)
        except nx.PowerIterationFailedConvergence:
            ev = {n: 0.0 for n in sub.nodes()}
    return {n: float(ev.get(n, 0.0)) for n in g.nodes()}


def _maybe_closeness(g: nx.Graph) -> dict:
    """Closeness centrality is O(N*E); skip on giant graphs. We pay it
    when N <= CLOSENESS_FULL_THRESHOLD, else we sample N//5 nodes."""
    n = g.number_of_nodes()
    if n == 0:
        return {}
    if n <= CLOSENESS_FULL_THRESHOLD:
        return nx.closeness_centrality(g)
    # k-sample approximation — networkx 3.x doesn't ship a built-in,
    # so we time-cap by computing on a random sample and applying
    # values to those nodes only; non-sampled get 0.
    import random
    random.seed(42)
    sample = set(random.sample(list(g.nodes()), max(1, n // 5)))
    out = {nid: 0.0 for nid in g.nodes()}
    for nid in sample:
        out[nid] = nx.closeness_centrality(g, u=nid)
    return out


def _build_layout(g: nx.Graph, geo_pos: dict) -> dict:
    if g.number_of_nodes() == 0:
        return {}
    seed = geo_pos if (LAYOUT_SEED_FROM_GEOGRAPHY and geo_pos) else None
    try:
        return nx.spring_layout(
            g,
            pos=seed,
            iterations=LAYOUT_ITERATIONS,
            scale=LAYOUT_SCALE,
            seed=42,
        )
    except Exception:
        # Fall back to circular if spring blows up (rare; usually only
        # when seed positions are degenerate). Circular keeps the
        # downstream schema valid.
        return nx.circular_layout(g, scale=LAYOUT_SCALE)


def analyze_graph(df):
    """Tableau Prep entry. One row per edge endpoint. Output schema is
    declared by `get_output_schema` and must match exactly or Maestro
    rejects the script with `Unable to retrieve results for field`."""
    if df is None or len(df) == 0:
        return _empty_output()

    # 1. Build node coords from edge endpoints
    coords = _node_coords_from_edges(df)

    # 2. Build undirected graph (transmission lines are bidirectional)
    g = nx.Graph()
    for _, r in df.iterrows():
        s, t = r.get(SOURCE_COL), r.get(TARGET_COL)
        if s in (None, "") or t in (None, "") or pd.isna(s) or pd.isna(t):
            continue
        if s == t:  # self-loops aren't meaningful for centralities here
            continue
        g.add_edge(str(s), str(t))

    # 3. Layout + centralities
    pos = _build_layout(g, {n: coords[n] for n in g.nodes() if n in coords})
    deg = nx.degree_centrality(g) if g.number_of_nodes() else {}
    btw = nx.betweenness_centrality(g) if g.number_of_nodes() else {}
    ev = _safe_eigenvector(g)
    pr = nx.pagerank(g, alpha=0.85) if g.number_of_nodes() else {}
    cls_ = _maybe_closeness(g)

    # 4. Emit two rows per edge (one per endpoint).
    out_rows = []
    edge_id = 0
    for _, r in df.iterrows():
        s, t = r.get(SOURCE_COL), r.get(TARGET_COL)
        if s in (None, "") or t in (None, "") or pd.isna(s) or pd.isna(t):
            continue
        edge_id += 1
        for path_order, nid, lon, lat in (
            (1, str(s), r.get("start_lon"), r.get("start_lat")),
            (2, str(t), r.get("end_lon"),   r.get("end_lat")),
        ):
            base = {k: r.get(k) for k in df.columns}
            lx, ly = pos.get(nid, (0.0, 0.0))
            base.update({
                "edge_id": int(edge_id),
                "path_order": int(path_order),
                "node_id": nid,
                "longitude": float(lon) if lon is not None and not pd.isna(lon) else 0.0,
                "latitude": float(lat) if lat is not None and not pd.isna(lat) else 0.0,
                "layout_x": float(lx),
                "layout_y": float(ly),
                "degree_centrality": float(deg.get(nid, 0.0)),
                "betweenness_centrality": float(btw.get(nid, 0.0)),
                "eigenvector_centrality": float(ev.get(nid, 0.0)),
                "pagerank": float(pr.get(nid, 0.0)),
                "closeness_centrality": float(cls_.get(nid, 0.0)),
            })
            out_rows.append(base)

    return pd.DataFrame(out_rows)


def _empty_output():
    cols = list(INPUT_SCHEMA.keys()) + [
        "edge_id", "path_order", "node_id",
        "longitude", "latitude", "layout_x", "layout_y",
        "degree_centrality", "betweenness_centrality",
        "eigenvector_centrality", "pagerank", "closeness_centrality",
    ]
    return pd.DataFrame(columns=cols)


def _prep_type_for(decl: str):
    decl = (decl or "string").lower()
    if decl == "int":
        return prep_int()  # noqa: F821
    if decl in ("decimal", "float", "double"):
        return prep_decimal()  # noqa: F821
    if decl == "bool":
        return prep_bool()  # noqa: F821
    return prep_string()  # noqa: F821


def get_output_schema():
    schema = {name: _prep_type_for(decl) for name, decl in INPUT_SCHEMA.items()}
    schema.update({
        "edge_id":                 prep_int(),       # noqa: F821
        "path_order":              prep_int(),       # noqa: F821
        "node_id":                 prep_string(),    # noqa: F821
        "longitude":               prep_decimal(),   # noqa: F821
        "latitude":                prep_decimal(),   # noqa: F821
        "layout_x":                prep_decimal(),   # noqa: F821
        "layout_y":                prep_decimal(),   # noqa: F821
        "degree_centrality":       prep_decimal(),   # noqa: F821
        "betweenness_centrality":  prep_decimal(),   # noqa: F821
        "eigenvector_centrality":  prep_decimal(),   # noqa: F821
        "pagerank":                prep_decimal(),   # noqa: F821
        "closeness_centrality":    prep_decimal(),   # noqa: F821
    })
    return pd.DataFrame(schema)
