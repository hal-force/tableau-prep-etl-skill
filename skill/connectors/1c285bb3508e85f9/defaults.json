{
  "verify_ssl": true,
  "timeout_s": 60,
  "max_retries": 3,
  "json_paginate": false,
  "json_derived_columns": [
    {
      "name": "latitude",
      "kind": "dotted_path",
      "source_col": "location",
      "path": "latitude",
      "cast": "decimal"
    },
    {
      "name": "longitude",
      "kind": "dotted_path",
      "source_col": "location",
      "path": "longitude",
      "cast": "decimal"
    },
    {
      "name": "street_name",
      "kind": "dotted_path",
      "source_col": "location",
      "path": "street.name",
      "cast": "string"
    },
    {
      "name": "street_id",
      "kind": "dotted_path",
      "source_col": "location",
      "path": "street.id",
      "cast": "string"
    },
    {
      "name": "outcome_category",
      "kind": "dotted_path",
      "source_col": "outcome_status",
      "path": "category",
      "cast": "string",
      "default": ""
    },
    {
      "name": "outcome_month",
      "kind": "dotted_path",
      "source_col": "outcome_status",
      "path": "date",
      "cast": "string",
      "default": ""
    },
    {
      "name": "crime_severity_band",
      "kind": "map_values",
      "source_col": "category",
      "mapping": {
        "violent-crime": "high",
        "robbery": "high",
        "possession-of-weapons": "high",
        "burglary": "medium",
        "drugs": "medium",
        "vehicle-crime": "medium",
        "theft-from-the-person": "medium",
        "shoplifting": "low",
        "bicycle-theft": "low",
        "criminal-damage-arson": "medium",
        "public-order": "low",
        "anti-social-behaviour": "low",
        "other-theft": "low",
        "other-crime": "low"
      },
      "default": "low"
    },
    {
      "name": "outcome_stage",
      "kind": "map_values",
      "source_col": "outcome_category",
      "mapping": {
        "Awaiting court outcome": "awaiting_court",
        "Under investigation": "under_investigation",
        "Investigation complete; no suspect identified": "no_suspect",
        "Unable to prosecute suspect": "no_prosecution",
        "Status update unavailable": "status_unknown",
        "Local resolution": "local_resolution",
        "Offender given penalty notice": "penalty_notice",
        "Offender given a caution": "caution",
        "Court result unavailable": "awaiting_court",
        "Court case unable to proceed": "no_prosecution",
        "Suspect charged as part of another case": "charged_elsewhere",
        "Offender given community sentence": "community_sentence",
        "Offender sent to prison": "custodial",
        "Offender given a drugs possession warning": "drug_warning",
        "Offender fined": "fined",
        "Formal action is not in the public interest": "no_action",
        "Action to be taken by another organisation": "referred_out"
      },
      "default": "unreported"
    }
  ],
  "json_schema": {
    "id": "string",
    "persistent_id": "string",
    "category": "string",
    "crime_severity_band": "string",
    "month": "string",
    "location_type": "string",
    "location_subtype": "string",
    "latitude": "decimal",
    "longitude": "decimal",
    "street_id": "string",
    "street_name": "string",
    "outcome_category": "string",
    "outcome_month": "string",
    "outcome_stage": "string",
    "context": "string"
  },
  "_skip_auto_casts": true
}