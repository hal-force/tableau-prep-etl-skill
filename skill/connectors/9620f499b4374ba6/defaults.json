{
  "verify_ssl": true,
  "timeout_s": 90,
  "max_retries": 3,
  "json_paginate": true,
  "json_page_kind": "page",
  "json_page_param": "page",
  "json_page_size_param": "per_page",
  "json_page_size": 100,
  "json_page_start": 1,
  "json_max_pages": 60,
  "json_max_rows": 6000,
  "json_records_path": "results",
  "json_derived_columns": [
    {
      "name": "receipts_band",
      "kind": "numeric_bin",
      "source_col": "receipts",
      "thresholds": [
        10000,
        100000,
        1000000,
        5000000
      ],
      "labels": [
        "micro",
        "small",
        "mid",
        "large",
        "mega"
      ],
      "default": "unknown"
    },
    {
      "name": "party_class",
      "kind": "map_values",
      "source_col": "party",
      "mapping": {
        "DEM": "democratic",
        "REP": "republican",
        "LIB": "libertarian",
        "GRE": "green",
        "IND": "independent",
        "CON": "constitution",
        "SLP": "socialist_labor",
        "REF": "reform"
      },
      "default": "other"
    }
  ],
  "json_schema": {
    "candidate_id": "string",
    "name": "string",
    "office": "string",
    "office_full": "string",
    "state": "string",
    "state_full": "string",
    "district": "string",
    "party": "string",
    "party_class": "string",
    "party_full": "string",
    "incumbent_challenge": "string",
    "incumbent_challenge_full": "string",
    "cycle": "int",
    "cash_on_hand_end_period": "decimal",
    "receipts": "decimal",
    "receipts_band": "string",
    "disbursements": "decimal",
    "individual_itemized_contributions": "decimal",
    "other_political_committee_contributions": "decimal",
    "transfers_from_other_authorized_committee": "decimal",
    "debts_owed_by_committee": "decimal",
    "coverage_start_date": "string",
    "coverage_end_date": "string",
    "has_raised_funds": "bool",
    "candidate_inactive": "bool"
  },
  "_skip_auto_casts": true
}