{
  "verify_ssl": true,
  "timeout_s": 90,
  "max_retries": 3,
  "json_paginate": true,
  "json_page_kind": "offset",
  "json_page_param": "$offset",
  "json_page_size_param": "$limit",
  "json_page_size": 5000,
  "json_page_start": 0,
  "json_max_pages": 60,
  "json_max_rows": 300000,
  "json_derived_columns": [
    {
      "name": "victim_age_band",
      "kind": "numeric_bin",
      "source_col": "vict_age",
      "thresholds": [
        1,
        18,
        30,
        50
      ],
      "labels": [
        "unknown",
        "child",
        "young_adult",
        "adult",
        "senior"
      ],
      "default": "unknown"
    },
    {
      "name": "crime_class",
      "kind": "map_values",
      "source_col": "part_1_2",
      "mapping": {
        "1": "part_1_violent_property",
        "2": "part_2_other"
      },
      "default": "unknown"
    }
  ],
  "json_schema": {
    "dr_no": "string",
    "date_rptd": "string",
    "date_occ": "string",
    "time_occ": "string",
    "area": "string",
    "area_name": "string",
    "rpt_dist_no": "string",
    "part_1_2": "string",
    "crime_class": "string",
    "crm_cd": "string",
    "crm_cd_desc": "string",
    "mocodes": "string",
    "vict_age": "int",
    "victim_age_band": "string",
    "vict_sex": "string",
    "vict_descent": "string",
    "premis_cd": "string",
    "premis_desc": "string",
    "status": "string",
    "status_desc": "string",
    "crm_cd_1": "string",
    "location": "string",
    "lat": "decimal",
    "lon": "decimal"
  },
  "_skip_auto_casts": true
}