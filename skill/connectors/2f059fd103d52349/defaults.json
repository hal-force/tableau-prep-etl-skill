{
  "verify_ssl": true,
  "timeout_s": 90,
  "max_retries": 3,
  "json_paginate": true,
  "json_page_kind": "offset",
  "json_page_param": "$offset",
  "json_page_size_param": "$limit",
  "json_page_size": 5000,
  "json_page_start": 0,
  "json_max_pages": 60,
  "json_max_rows": 220000,
  "json_derived_columns": [
    {
      "name": "measure_class",
      "kind": "map_values",
      "source_col": "categoryid",
      "mapping": {
        "HLTHOUT": "health_outcomes",
        "PREVENT": "prevention",
        "HLTHSTAT": "health_status",
        "RISKBEH": "risk_behaviors",
        "DISABILT": "disability",
        "SOCLNEEDS": "social_needs"
      },
      "default": "other"
    },
    {
      "name": "value_band",
      "kind": "numeric_bin",
      "source_col": "data_value",
      "bins": [
        {
          "max": 10,
          "label": "low"
        },
        {
          "max": 20,
          "label": "moderate"
        },
        {
          "max": 30,
          "label": "elevated"
        },
        {
          "max": 100,
          "label": "high"
        }
      ]
    },
    {
      "name": "pop_band",
      "kind": "numeric_bin",
      "source_col": "totalpopulation",
      "bins": [
        {
          "max": 25000,
          "label": "tiny"
        },
        {
          "max": 100000,
          "label": "small"
        },
        {
          "max": 500000,
          "label": "mid"
        },
        {
          "max": 100000000,
          "label": "large"
        }
      ]
    }
  ],
  "json_schema": {
    "year": "string",
    "stateabbr": "string",
    "statedesc": "string",
    "locationname": "string",
    "datasource": "string",
    "category": "string",
    "measure": "string",
    "data_value_unit": "string",
    "data_value_type": "string",
    "data_value": "decimal",
    "low_confidence_limit": "decimal",
    "high_confidence_limit": "decimal",
    "totalpopulation": "integer",
    "totalpop18plus": "integer",
    "locationid": "string",
    "categoryid": "string",
    "measureid": "string",
    "datavaluetypeid": "string",
    "short_question_text": "string",
    "measure_class": "string",
    "value_band": "string",
    "pop_band": "string"
  },
  "_skip_auto_casts": true
}