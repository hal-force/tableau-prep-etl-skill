{
  "verify_ssl": true,
  "timeout_s": 120,
  "max_retries": 3,
  "json_paginate": true,
  "json_page_kind": "offset",
  "json_page_param": "$offset",
  "json_page_size_param": "$limit",
  "json_page_size": 5000,
  "json_page_start": 0,
  "json_max_pages": 18,
  "json_max_rows": 90000,
  "json_derived_columns": [
    {
      "name": "utilization_band",
      "kind": "numeric_bin",
      "source_col": "inpatient_beds_utilization",
      "thresholds": [
        0.5,
        0.7,
        0.85
      ],
      "labels": [
        "low",
        "moderate",
        "high",
        "crisis"
      ],
      "default": "unknown"
    },
